<%- include('partials/header') %>
<div class="container py-4">
  <h2 class="mb-4">আমার অ্যাকাউন্ট</h2>
  <div class="row g-4">
    <div class="col-lg-5">
      <div class="checkout-box">
        <h5>প্রোফাইল তথ্য</h5>
        <form method="post" action="/account">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <div class="mb-3"><label class="form-label">নাম</label><input type="text" name="name" class="form-control" value="<%= customer.name %>"></div>
          <div class="mb-3"><label class="form-label">ইমেইল</label><input type="email" class="form-control" value="<%= customer.email %>" disabled></div>
          <div class="mb-3"><label class="form-label">মোবাইল</label><input type="text" name="phone" class="form-control" value="<%= customer.phone %>"></div>
          <div class="mb-3"><label class="form-label">ঠিকানা</label><textarea name="address" class="form-control"><%= customer.address %></textarea></div>
          <div class="mb-3"><label class="form-label">শহর</label><input type="text" name="city" class="form-control" value="<%= customer.city %>"></div>
          <button type="submit" class="btn btn-primary w-100">আপডেট করুন</button>
        </form>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="checkout-box">
        <h5>আমার অর্ডারসমূহ</h5>
        <% if (!orders.length) { %>
          <p class="text-muted">এখনো কোনো অর্ডার করেননি।</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead><tr><th>অর্ডার#</th><th>তারিখ</th><th>মোট</th><th>স্ট্যাটাস</th><th></th></tr></thead>
              <tbody>
                <% orders.forEach(function (o) { %>
                  <tr>
                    <td>#<%= o.orderNumber %></td>
                    <td><%= new Date(o.createdAt).toLocaleDateString('bn-BD', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td><%= currency(o.total) %></td>
                    <td><span class="badge bg-secondary"><%= o.status.charAt(0).toUpperCase() + o.status.slice(1) %></span></td>
                    <td><a href="/track-order?order=<%= o.orderNumber %>" class="btn btn-sm btn-outline-primary">দেখুন</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
