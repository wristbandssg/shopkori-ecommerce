<%
  const ogImage = (category && category.image) ? baseUrl + categoryImageUrl(category.image) : '';
%>
<%- include('partials/header', { ogImage }) %>

<%
  // ---- schema.org structured data ----
  // BreadcrumbList so Google can show Home > Category in the search result
  // path, and an ItemList of this page's products so a category/collection
  // page reads as a real product listing, not just plain text + links.
  const breadcrumbItems = [{ '@type': 'ListItem', position: 1, name: 'হোম', item: baseUrl + '/' }];
  if (category) breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: category.name, item: baseUrl + '/category/' + category.slug });
  const categoryBreadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbItems };
  const categoryItemListSchema = products.length ? {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: products.map(function (p, i) {
      return { '@type': 'ListItem', position: (page - 1) * perPage + i + 1, url: baseUrl + '/product/' + p.slug };
    }),
  } : null;
%>
<script type="application/ld+json"><%- JSON.stringify(categoryBreadcrumbSchema) %></script>
<% if (categoryItemListSchema) { %><script type="application/ld+json"><%- JSON.stringify(categoryItemListSchema) %></script><% } %>

<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">হোম</a></li>
      <li class="breadcrumb-item active"><%= pageTitle %></li>
    </ol>
  </nav>

  <% if (category && (category.pageTitle || category.shortDescription)) { %>
    <div class="category-intro mb-3">
      <% if (category.pageTitle) { %><h1 class="category-intro-title"><%= category.pageTitle %></h1><% } %>
      <% if (category.shortDescription) { %><p class="category-intro-text text-muted"><%- nl2br(category.shortDescription) %></p><% } %>
    </div>
  <% } %>

  <div class="row">
    <div class="col-lg-3 mb-4">
      <div class="filter-box">
        <h6>ক্যাটাগরি</h6>
        <ul class="filter-cat-list">
          <li><a href="/category" class="<%= !category ? 'active' : '' %>">সকল প্রোডাক্ট</a></li>
          <% allCategories.forEach(function (c) { %>
            <li><a href="/category/<%= c.slug %>" class="<%= (category && String(category._id) === String(c._id)) ? 'active' : '' %>"><%= c.name %></a></li>
          <% }); %>
        </ul>
      </div>
    </div>

    <div class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="mb-0"><%= category && category.pageTitle ? category.name : pageTitle %> <small class="text-muted">(<%= total %> টি প্রোডাক্ট)</small></h4>
        <form method="get" class="d-flex align-items-center gap-2">
          <label class="mb-0 small">সাজান:</label>
          <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>নতুন</option>
            <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>মূল্য: কম থেকে বেশি</option>
            <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>মূল্য: বেশি থেকে কম</option>
            <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>জনপ্রিয়তা</option>
          </select>
        </form>
      </div>

      <% if (!products.length) { %>
        <div class="alert alert-info">এই মুহূর্তে কোনো প্রোডাক্ট পাওয়া যায়নি।</div>
      <% } else { %>
        <div class="product-grid">
          <% products.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
        </div>

        <% if (totalPages > 1) { %>
          <nav class="mt-4">
            <ul class="pagination justify-content-center">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>">
                  <a class="page-link" href="<%= category ? `/category/${category.slug}` : '/category' %>?sort=<%= sort %>&page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
      <% } %>
    </div>
  </div>

  <% if (category && category.description) { %>
    <div class="category-seo-content mt-4 pt-4 border-top">
      <%- category.description %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
