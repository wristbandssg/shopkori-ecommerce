<%
  const paymentLabels = {
    cod: { icon: 'bi-cash-coin', text: 'ক্যাশ অন ডেলিভারি (COD)' },
    bkash: { icon: 'bi-phone', text: 'bKash' },
    sslcommerz: { icon: 'bi-credit-card', text: 'কার্ড / মোবাইল ব্যাংকিং (SSLCommerz)' },
  };
  const defaultMethod = formData.paymentMethod || (allowedMethods.length ? allowedMethods[0] : 'cod');
%>
<%- include('partials/header') %>

<div class="container py-4">
  <h2 class="mb-4">চেকআউট</h2>

  <% if (errors.length) { %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% errors.forEach(function (err) { %><li><%= err %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <% if (!allowedMethods.length) { %>
    <div class="alert alert-warning">আপনার কার্টের প্রোডাক্টগুলোর জন্য কোনো পেমেন্ট মেথড সমর্থিত নয়। অনুগ্রহ করে কার্ট সম্পাদনা করুন।</div>
  <% } %>

  <form method="post" action="/checkout" id="checkoutForm">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <% if (buyNowId) { %><input type="hidden" name="buyNowId" value="<%= buyNowId %>"><% } %>
    <% if (buyNowVariantId) { %><input type="hidden" name="buyNowVariantId" value="<%= buyNowVariantId %>"><% } %>
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="checkout-box">
          <h5>ডেলিভারি তথ্য</h5>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">পুরো নাম *</label>
              <input type="text" name="name" class="form-control" required value="<%= formData.name || (customer ? customer.name : '') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">মোবাইল নম্বর *</label>
              <input type="text" name="phone" class="form-control" required placeholder="01XXXXXXXXX" value="<%= formData.phone || (customer ? customer.phone : '') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">ইমেইল (ঐচ্ছিক)</label>
              <input type="email" name="email" class="form-control" value="<%= formData.email || (customer ? customer.email : '') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label">শহর</label>
              <input type="text" name="city" class="form-control" value="<%= formData.city || (customer ? customer.city : 'Dhaka') %>">
            </div>
            <div class="col-12">
              <label class="form-label">সম্পূর্ণ ঠিকানা *</label>
              <textarea name="address" class="form-control" rows="2" required><%= formData.address || (customer ? customer.address : '') %></textarea>
            </div>
            <div class="col-12">
              <label class="form-label">অর্ডার নোট (ঐচ্ছিক)</label>
              <textarea name="notes" class="form-control" rows="2"><%= formData.notes || '' %></textarea>
            </div>
          </div>
        </div>

        <div class="checkout-box mt-4">
          <h5>পেমেন্ট মেথড</h5>

          <% ['cod', 'bkash', 'sslcommerz'].forEach(function (m) {
               const allowed = allowedMethods.includes(m);
               const label = paymentLabels[m];
          %>
            <div class="payment-option <%= allowed ? '' : 'disabled' %>">
              <label>
                <input type="radio" name="paymentMethod" value="<%= m %>" <%= !allowed ? 'disabled' : '' %> <%= (allowed && defaultMethod === m) ? 'checked' : '' %> <%= m === 'bkash' ? 'id="pmBkash"' : '' %>>
                <span><i class="bi <%= label.icon %>"></i> <%= label.text %><% if (m === 'bkash' && settings.bkash_number) { %> (Send Money)<% } %></span>
                <% if (!allowed) { %><small class="text-danger ms-2">এই প্রোডাক্টের জন্য উপলব্ধ নয়</small><% } %>
              </label>
              <% if (m === 'bkash') { %>
                <div class="payment-extra" id="bkashExtra" style="display:<%= (allowed && defaultMethod === 'bkash') ? 'block' : 'none' %>">
                  <p class="small mb-2"><strong><%= settings.bkash_number %></strong> নম্বরে <strong><%= currency(grandTotal) %></strong> "Send Money" করুন, তারপর নিচে Transaction ID দিন।</p>
                  <input type="text" name="bkashTrxId" class="form-control" placeholder="bKash Transaction ID" value="<%= formData.bkashTrxId || '' %>">
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="checkout-box order-summary-box">
          <h5>অর্ডার সামারি</h5>
          <ul class="checkout-item-list">
            <% items.forEach(function (item) { %>
              <li>
                <img src="<%= productImageUrl(item.product.image) %>" alt="">
                <div class="flex-grow-1">
                  <div><%= item.product.name %><% if (item.variantLabel) { %> <small class="text-muted">(<%= item.variantLabel %>)</small><% } %></div>
                  <small class="text-muted">Qty: <%= item.qty %></small>
                </div>
                <div><%= currency(item.lineTotal) %></div>
              </li>
            <% }); %>
          </ul>
          <hr>
          <div class="d-flex justify-content-between"><span>সাবটোটাল</span><span><%= currency(subtotal) %></span></div>
          <div class="d-flex justify-content-between"><span>ডেলিভারি চার্জ</span><span><%= currency(shippingFee) %></span></div>
          <hr>
          <div class="d-flex justify-content-between fw-bold fs-5"><span>মোট</span><span><%= currency(grandTotal) %></span></div>
          <button type="submit" class="btn btn-buy-now w-100 mt-3" <%= !allowedMethods.length ? 'disabled' : '' %>>অর্ডার কনফার্ম করুন <i class="bi bi-check2-circle"></i></button>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
document.querySelectorAll('input[name="paymentMethod"]').forEach(function (radio) {
  radio.addEventListener('change', function () {
    var pmBkash = document.getElementById('pmBkash');
    document.getElementById('bkashExtra').style.display = (pmBkash && pmBkash.checked) ? 'block' : 'none';
  });
});
</script>

<%- include('partials/footer') %>
