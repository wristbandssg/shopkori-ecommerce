<%- include('partials/header') %>
<div class="container py-5">
  <div class="static-page mx-auto">
    <h2><%= settings.site_name %> সম্পর্কে</h2>
    <p><%= settings.site_name %> একটি বাংলাদেশ-ভিত্তিক অনলাইন শপিং প্ল্যাটফর্ম, যেখানে গিফট, ফুল, কেক, চকলেট হ্যাম্পার থেকে শুরু করে দৈনন্দিন গ্রোসারি — সবকিছু এক জায়গায় পাওয়া যায়। আমরা ঢাকার মধ্যে সেম ডে ডেলিভারি এবং সারাদেশে দ্রুত হোম ডেলিভারি নিশ্চিত করি।</p>
    <p>এই ওয়েবসাইটটি একটি ডেমো/স্টার্টার ইকমার্স প্রজেক্ট হিসেবে Node.js (Express) ও MongoDB দিয়ে তৈরি — আপনি চাইলে এটি নিজের প্রয়োজন অনুযায়ী কাস্টমাইজ করে ব্যবহার করতে পারবেন।</p>
  </div>
</div>
<%- include('partials/footer') %>
