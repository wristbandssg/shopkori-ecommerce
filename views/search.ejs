<%- include('partials/header') %>
<div class="container py-4">
  <h4 class="mb-4">"<%= q %>" এর জন্য <%= products.length %> টি ফলাফল পাওয়া গেছে</h4>
  <% if (!products.length) { %>
    <div class="alert alert-info">কোনো প্রোডাক্ট পাওয়া যায়নি। অন্য কিছু দিয়ে সার্চ করে দেখুন।</div>
  <% } else { %>
    <div class="product-grid">
      <% products.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
