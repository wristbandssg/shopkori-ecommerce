<%
  // Open Graph image/type for the <head> tags in partials/header — computed
  // here (before the include) since EJS includes share the caller's scope,
  // same convention as views/product.ejs.
  const ogImage = post.coverImage ? (baseUrl + productImageUrl(post.coverImage)) : '';
  const ogType = 'article';
%>
<%- include('partials/header', { ogImage, ogType }) %>

<%
  // ---- schema.org structured data ----
  // Article: so Google can show this as a rich article result (headline,
  // image, date). No author/publisher person claimed — just the site itself.
  const postUrl = baseUrl + '/blog/' + post.slug;
  const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: (post.excerpt || '').trim() || undefined,
    image: ogImage ? [ogImage] : undefined,
    datePublished: post.createdAt,
    dateModified: post.updatedAt || post.createdAt,
    publisher: { '@type': 'Organization', name: settings.site_name },
    mainEntityOfPage: postUrl,
    articleSection: post.category || undefined,
    keywords: (post.tags && post.tags.length) ? post.tags.join(', ') : undefined,
  };
  const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'হোম', item: baseUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'ব্লগ', item: baseUrl + '/blog' },
      { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
    ],
  };
%>
<script type="application/ld+json"><%- JSON.stringify(articleSchema) %></script>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbSchema) %></script>

<div class="container py-5">
  <div class="static-page mx-auto">
    <% if (post.coverImage) { %>
      <img src="<%= productImageUrl(post.coverImage) %>" alt="<%= post.coverImageAlt || post.title %>" class="img-fluid rounded mb-4" style="width:100%; max-height:420px; object-fit:cover;">
    <% } %>
    <small class="text-muted"><%= post.createdAt.toLocaleDateString('bn-BD') %><% if (post.category) { %> · <a href="/blog?category=<%= encodeURIComponent(post.category) %>" class="text-decoration-none"><%= post.category %></a><% } %></small>
    <h2 class="mt-1"><%= post.title %></h2>
    <% if (post.tags && post.tags.length) { %>
      <div class="mb-3 d-flex flex-wrap gap-2">
        <% post.tags.forEach(function (t) { %>
          <a href="/blog?tag=<%= encodeURIComponent(t) %>" class="badge bg-light text-dark border text-decoration-none px-3 py-2">#<%= t %></a>
        <% }); %>
      </div>
    <% } %>
    <div class="mt-3"><%- renderRichText(post.content) %></div>
    <a href="/blog" class="btn btn-outline-secondary px-4 py-2 d-inline-block mt-4" style="width:auto;"><i class="bi bi-arrow-left"></i> ব্লগে ফিরে যান</a>

    <% if (relatedPosts && relatedPosts.length) { %>
      <hr class="my-4">
      <h5 class="mb-3">আরও পড়ুন</h5>
      <div class="row g-3">
        <% relatedPosts.forEach(function (rp) { %>
          <div class="col-6 col-md-4">
            <a href="/blog/<%= rp.slug %>" class="text-decoration-none">
              <div class="product-card h-100">
                <div class="product-card-img">
                  <img src="<%= rp.coverImage ? productImageUrl(rp.coverImage) : '/images/product-placeholder.svg' %>" alt="<%= rp.coverImageAlt || rp.title %>">
                </div>
                <div class="product-card-body">
                  <div class="product-title"><%= rp.title %></div>
                </div>
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
