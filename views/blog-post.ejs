<%- include('partials/header') %>
<div class="container py-5">
  <div class="static-page mx-auto">
    <% if (post.coverImage) { %>
      <img src="<%= productImageUrl(post.coverImage) %>" alt="<%= post.title %>" class="img-fluid rounded mb-4" style="width:100%; max-height:420px; object-fit:cover;">
    <% } %>
    <small class="text-muted"><%= post.createdAt.toLocaleDateString('bn-BD') %></small>
    <h2 class="mt-1"><%= post.title %></h2>
    <div class="mt-3"><%- nl2br(post.content) %></div>
    <a href="/blog" class="btn btn-outline-secondary px-4 py-2 d-inline-block mt-4" style="width:auto;"><i class="bi bi-arrow-left"></i> ব্লগে ফিরে যান</a>
  </div>
</div>
<%- include('partials/footer') %>
