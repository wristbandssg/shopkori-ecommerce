<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  const pageMetaTitle = (typeof metaTitle !== 'undefined' && metaTitle) ? metaTitle : pageTitle;
  const pageMetaDescription = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : settings.site_tagline;
  const canonicalUrl = baseUrl + (typeof currentUrl !== 'undefined' ? currentUrl : '/');
  const ogImageUrl = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : '';
%>
<title><%= pageMetaTitle %> | <%= settings.site_name %></title>
<meta name="description" content="<%= pageMetaDescription %>">
<% if (typeof metaKeywords !== 'undefined' && metaKeywords) { %><meta name="keywords" content="<%= metaKeywords %>"><% } %>
<link rel="canonical" href="<%= canonicalUrl %>">

<!-- Open Graph / social share -->
<meta property="og:site_name" content="<%= settings.site_name %>">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<meta property="og:title" content="<%= pageMetaTitle %>">
<meta property="og:description" content="<%= pageMetaDescription %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<% if (ogImageUrl) { %><meta property="og:image" content="<%= ogImageUrl %>"><% } %>
<meta name="twitter:card" content="<%= ogImageUrl ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= pageMetaTitle %>">
<meta name="twitter:description" content="<%= pageMetaDescription %>">
<% if (ogImageUrl) { %><meta name="twitter:image" content="<%= ogImageUrl %>"><% } %>

<link rel="icon" href="/images/favicon.svg">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="/css/style.css" rel="stylesheet">

<!-- Admin > Customization > Advance Theme Setup — overrides public/css/style.css's
     variables/selectors with the admin's saved theme. Only fields documented as
     LIVE in models/ThemeCustomizer.js are applied here; the rest are saved-only. -->
<% if (typeof themeCustomizer !== 'undefined' && themeCustomizer) {
  var th = themeCustomizer;
  var catCols = parseInt(th.category.rowItem, 10) || 6;
  var tabletCatCols = Math.max(2, Math.min(4, catCols));
  var mobileCatCols = Math.max(2, Math.min(3, catCols));
%>
<style id="theme-customizer">
  :root {
    --brand-pink: <%- th.navMenu.backgroundColor || '#EC0E8C' %>;
    --brand-blue: <%- th.product.buyNowColor || '#2F5FE0' %>;
    --text-dark: <%- th.product.nameColor || '#222222' %>;
  }
  <% if (th.topHeader.text) { %>
  .theme-top-header {
    background: <%- th.topHeader.backgroundColor %>;
    color: <%- th.topHeader.color %>;
    text-align: <%- th.topHeader.textAlign %>;
    font-weight: <%- th.topHeader.bold ? '700' : '400' %>;
    padding: 6px 16px;
    font-size: 13px;
    <% if (th.topHeader.scrollingMarquee) { %>white-space: nowrap; overflow: hidden;<% } %>
  }
  <% if (th.topHeader.scrollingMarquee) { %>
  .theme-top-header marquee { display: inline; }
  <% } %>
  <% } %>
  .main-header { background: <%- th.header.backgroundColor %>; }
  .brand-logo, .brand-logo i { color: <%- th.header.textColor %>; }
  .category-nav { background: <%- th.navMenu.backgroundColor %>; }
  .category-nav .nav-list li a, .nav-toggle, .nav-home-link { color: <%- th.navMenu.linksColor %>; font-family: <%- th.navMenu.fontFamily %>; }
  .category-nav .nav-list > li > a:hover, .category-nav .nav-list > li:hover > a { color: <%- th.navMenu.linkHoverColor %>; }
  .category-grid { grid-template-columns: repeat(<%- catCols %>, 1fr); }
  @media (max-width: 991px) { .category-grid { grid-template-columns: repeat(<%- tabletCatCols %>, 1fr); } }
  @media (max-width: 575px) { .category-grid { grid-template-columns: repeat(<%- mobileCatCols %>, 1fr); } }
  .category-tile { background: <%- th.category.rowBackgroundColor %>; border-color: <%- th.category.borderColor %>; }
  .category-tile-img { border-radius: <%- th.category.bodyShape %>; background: <%- th.category.previewBackgroundColor %>; }
  .category-tile span { color: <%- th.category.previewTextColor %>; }
  .product-grid { grid-template-columns: repeat(<%- th.home.productsDesktop %>, 1fr); }
  @media (max-width: 991px) { .product-grid { grid-template-columns: repeat(<%- th.home.productsTablet %>, 1fr); } }
  @media (max-width: 767px) { .product-grid { grid-template-columns: repeat(<%- th.home.productsMobile %>, 1fr); } }
  .product-title { color: <%- th.product.nameColor %>; font-size: <%- th.product.nameSize %>; }
  .price-now { color: <%- th.product.priceColor %>; font-size: <%- th.product.priceTextSize %>; }
  .price-old { color: <%- th.product.discountPriceTextColor %>; font-size: <%- th.product.discountPriceTextSize %>; }
  .badge-discount { background: <%- th.product.discountBarBgColor %>; color: <%- th.product.discountBarTextColor %>; }
  .product-card { border-color: <%- th.product.cardBorderColor %>; border-width: <%- th.product.cardBorderSize %>; <%- th.product.boxStyle === 'without' ? 'border-style: none; box-shadow: none;' : 'border-style: solid;' %> }
  .btn-add-cart { background: <%- th.product.addToCartColor %>; color: <%- th.product.addToCartTextColor %>; order: <%- th.product.buttonOrder === 'buy-then-cart' ? '2' : '1' %>; }
  .btn-buy-now { background: <%- th.product.buyNowColor %>; color: <%- th.product.buyNowTextColor %>; order: <%- th.product.buttonOrder === 'buy-then-cart' ? '1' : '2' %>; }
  .product-actions { flex-direction: <%- th.product.buttonLayout === 'vertical' ? 'column' : 'row' %>; }
  .site-footer { background: <%- th.footer.backgroundColor %>; color: <%- th.footer.textColor %>; }
  .footer-links a, .footer-brand, .social-icons a { color: <%- th.footer.textColor %>; }
</style>
<% } %>

<!-- Sitewide structured data (schema.org): every page carries Organization +
     WebSite (with a Sitelinks Search Box action) so Google can attribute
     search results to the right business and offer an in-SERP search box.
     Page-specific schema (Product, BreadcrumbList, CollectionPage/ItemList)
     is added by the individual page templates below. -->
<script type="application/ld+json"><%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.site_name,
  url: baseUrl,
  logo: baseUrl + '/images/favicon.svg',
  ...(settings.phone ? { telephone: settings.phone } : {}),
  ...(settings.email ? { email: settings.email } : {}),
  ...(settings.address ? { address: { '@type': 'PostalAddress', streetAddress: settings.address } } : {}),
}) %></script>
<script type="application/ld+json"><%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.site_name,
  url: baseUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: baseUrl + '/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
}) %></script>

<!-- Admin > Marketing integrations — each snippet only loads once its card
     is turned ON and its id is filled in (see models/MarketingSetting.js). -->
<% if (typeof marketing !== 'undefined' && marketing.googleTagManager && marketing.googleTagManager.status && marketing.googleTagManager.containerId) { %>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%- marketing.googleTagManager.containerId %>');</script>
<% } %>
<% if (typeof marketing !== 'undefined' && marketing.googleAnalytics && marketing.googleAnalytics.status && marketing.googleAnalytics.measurementId) { %>
<!-- Google Analytics (GA4) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%- marketing.googleAnalytics.measurementId %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','<%- marketing.googleAnalytics.measurementId %>');</script>
<% } %>
<% if (typeof marketing !== 'undefined' && marketing.facebookPixel && marketing.facebookPixel.status && marketing.facebookPixel.pixelId) { %>
<!-- Facebook Pixel -->
<script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%- marketing.facebookPixel.pixelId %>');fbq('track','PageView');</script>
<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=<%- marketing.facebookPixel.pixelId %>&ev=PageView&noscript=1"></noscript>
<% } %>
<% if (typeof marketing !== 'undefined' && marketing.tiktokPixel && marketing.tiktokPixel.status && marketing.tiktokPixel.pixelId) { %>
<!-- TikTok Pixel -->
<script>!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=i,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};var o=document.createElement("script");o.type="text/javascript",o.async=!0,o.src=i+"?sdkid="+e+"&lib="+t;var a=document.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};ttq.load('<%- marketing.tiktokPixel.pixelId %>');ttq.page();}(window,document,'ttq');</script>
<% } %>
</head>
<body>
<% if (typeof marketing !== 'undefined' && marketing.googleTagManager && marketing.googleTagManager.status && marketing.googleTagManager.containerId) { %>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%- marketing.googleTagManager.containerId %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<% } %>

<% if (typeof themeCustomizer !== 'undefined' && themeCustomizer && themeCustomizer.topHeader.text) { %>
<div class="theme-top-header">
  <% if (themeCustomizer.topHeader.scrollingMarquee) { %>
    <marquee><%= themeCustomizer.topHeader.text %></marquee>
  <% } else { %>
    <%= themeCustomizer.topHeader.text %>
  <% } %>
</div>
<% } %>

<!-- Admin > Offer Setting > PopUp Offer — shown once per browser session
     (sessionStorage, so it doesn't reappear on every page nav) when a
     popup has been saved with an image. -->
<% if (typeof offerSettings !== 'undefined' && offerSettings.popup && offerSettings.popup.enabled && offerSettings.popup.image) { %>
<div class="modal fade" id="popupOfferModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:12px;overflow:hidden;">
      <button type="button" class="btn-close position-absolute top-0 end-0 m-2 bg-white rounded-circle p-2" style="z-index:2;" data-bs-dismiss="modal" aria-label="Close"></button>
      <% if (offerSettings.popup.url) { %><a href="<%= offerSettings.popup.url %>"><% } %>
        <img src="<%= productImageUrl(offerSettings.popup.image) %>" alt="<%= offerSettings.popup.title || 'অফার' %>" style="width:100%;display:block;">
      <% if (offerSettings.popup.url) { %></a><% } %>
      <% if (offerSettings.popup.title) { %><div class="p-2 text-center fw-semibold"><%= offerSettings.popup.title %></div><% } %>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  try {
    if (sessionStorage.getItem('popupOfferShown')) return;
  } catch (e) {}
  var el = document.getElementById('popupOfferModal');
  if (!el || typeof bootstrap === 'undefined') return;
  new bootstrap.Modal(el).show();
  try { sessionStorage.setItem('popupOfferShown', '1'); } catch (e) {}
});
</script>
<% } %>

<!-- Sticky header: single row (logo + search + icon-links), stays pinned on scroll along with the category bar below it -->
<header class="main-header">
  <div class="container header-row">
    <a href="/" class="brand-logo">
      <i class="bi bi-gift-fill"></i> <%= settings.site_name %>
    </a>

    <form action="/search" method="get" class="search-form">
      <input type="text" name="q" placeholder="প্রোডাক্ট খুঁজুন... (যেমনঃ কেক, ফুল, মধু)" value="<%= typeof q !== 'undefined' ? q : '' %>" required>
      <button type="submit"><i class="bi bi-search"></i></button>
    </form>

    <div class="header-actions">
      <a href="/track-order" class="header-action-link">
        <i class="bi bi-truck"></i>
        <span>অর্ডার ট্র্যাক</span>
      </a>

      <% if (customer) { %>
        <a href="/account" class="header-action-link">
          <i class="bi bi-person-circle"></i>
          <span>আমার অ্যাকাউন্ট</span>
        </a>
      <% } else { %>
        <a href="/login" class="header-action-link">
          <i class="bi bi-person"></i>
          <span>সাইন ইন</span>
        </a>
      <% } %>

      <a href="/cart" class="header-action-link cart-btn">
        <i class="bi bi-cart3"></i>
        <span class="cart-count" id="cartCount"><%= cartCount %></span>
        <span>কার্ট</span>
      </a>

      <div class="header-action-link more-dropdown dropdown">
        <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-grid-3x3-gap-fill"></i>
          <span>আরও</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><span class="dropdown-header"><i class="bi bi-telephone-fill"></i> <%= settings.phone %></span></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/blog">ব্লগ</a></li>
          <li><a class="dropdown-item" href="/how-to-order">অর্ডার কিভাবে করবেন?</a></li>
          <li><a class="dropdown-item" href="/how-to-pay">পেমেন্ট কিভাবে করবেন?</a></li>
          <li><a class="dropdown-item" href="/faq">FAQ</a></li>
          <li><a class="dropdown-item" href="/contact">যোগাযোগ</a></li>
          <li><a class="dropdown-item" href="/about">আমাদের সম্পর্কে</a></li>
          <% if (!customer) { %>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/login">লগইন / রেজিস্টার</a></li>
          <% } else { %>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/logout">লগআউট</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Category nav (mega menu, giftallbd.com style) -->
  <nav class="category-nav">
    <div class="container">
      <ul class="nav-list">
        <li><a href="/" class="nav-home-link"><i class="bi bi-house-door-fill"></i></a></li>
        <li class="mega-parent" id="allCatToggle">
          <span class="nav-toggle"><i class="bi bi-list"></i> সকল ক্যাটাগরি <i class="bi bi-chevron-down mega-caret"></i></span>
          <div class="mega-panel all-cat-panel">
            <div class="mega-panel-grid">
              <% navCategories.forEach(function (cat) { %>
                <div class="mega-col">
                  <a href="/category/<%= cat.slug %>" class="mega-col-title"><%= cat.name %></a>
                  <% if (cat.children && cat.children.length) { %>
                    <ul>
                      <% cat.children.forEach(function (sub) { %>
                        <li><a href="/category/<%= sub.slug %>"><%= sub.name %></a></li>
                      <% }); %>
                    </ul>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        </li>

        <% navCategories.forEach(function (cat) { %>
          <% if (cat.children && cat.children.length) { %>
            <li class="mega-parent">
              <a href="/category/<%= cat.slug %>"><%= cat.name %></a>
              <span class="mega-toggle"><i class="bi bi-chevron-down"></i></span>
              <div class="mega-panel">
                <div class="mega-panel-flat">
                  <% cat.children.forEach(function (sub) { %>
                    <a class="mega-sub-item" href="/category/<%= sub.slug %>">
                      <img src="<%= categoryImageUrl(sub.image) %>" alt="<%= sub.name %>">
                      <span><%= sub.name %></span>
                    </a>
                  <% }); %>
                </div>
              </div>
            </li>
          <% } else { %>
            <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
          <% } %>
        <% }); %>
      </ul>
    </div>
  </nav>
</header>

<div class="container">
  <% flashes.forEach(function (f) { %>
    <div class="alert alert-<%= f.type %> alert-dismissible fade show mt-3" role="alert">
      <%= f.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }); %>
</div>
