<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= (typeof metaTitle !== 'undefined' && metaTitle) ? metaTitle : pageTitle %> | <%= settings.site_name %></title>
<meta name="description" content="<%= (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : settings.site_tagline %>">
<% if (typeof metaKeywords !== 'undefined' && metaKeywords) { %><meta name="keywords" content="<%= metaKeywords %>"><% } %>
<link rel="icon" href="/images/favicon.svg">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="/css/style.css" rel="stylesheet">
</head>
<body>

<!-- Sticky header: single row (logo + search + icon-links), stays pinned on scroll along with the category bar below it -->
<header class="main-header">
  <div class="container header-row">
    <a href="/" class="brand-logo">
      <i class="bi bi-gift-fill"></i> <%= settings.site_name %>
    </a>

    <form action="/search" method="get" class="search-form">
      <input type="text" name="q" placeholder="প্রোডাক্ট খুঁজুন... (যেমনঃ কেক, ফুল, মধু)" value="<%= typeof q !== 'undefined' ? q : '' %>" required>
      <button type="submit"><i class="bi bi-search"></i></button>
    </form>

    <div class="header-actions">
      <a href="/track-order" class="header-action-link">
        <i class="bi bi-truck"></i>
        <span>অর্ডার ট্র্যাক</span>
      </a>

      <% if (customer) { %>
        <a href="/account" class="header-action-link">
          <i class="bi bi-person-circle"></i>
          <span>আমার অ্যাকাউন্ট</span>
        </a>
      <% } else { %>
        <a href="/login" class="header-action-link">
          <i class="bi bi-person"></i>
          <span>সাইন ইন</span>
        </a>
      <% } %>

      <a href="/cart" class="header-action-link cart-btn">
        <i class="bi bi-cart3"></i>
        <span class="cart-count" id="cartCount"><%= cartCount %></span>
        <span>কার্ট</span>
      </a>

      <div class="header-action-link more-dropdown dropdown">
        <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-grid-3x3-gap-fill"></i>
          <span>আরও</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><span class="dropdown-header"><i class="bi bi-telephone-fill"></i> <%= settings.phone %></span></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/blog">ব্লগ</a></li>
          <li><a class="dropdown-item" href="/how-to-order">অর্ডার কিভাবে করবেন?</a></li>
          <li><a class="dropdown-item" href="/how-to-pay">পেমেন্ট কিভাবে করবেন?</a></li>
          <li><a class="dropdown-item" href="/faq">FAQ</a></li>
          <li><a class="dropdown-item" href="/contact">যোগাযোগ</a></li>
          <li><a class="dropdown-item" href="/about">আমাদের সম্পর্কে</a></li>
          <% if (!customer) { %>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/login">লগইন / রেজিস্টার</a></li>
          <% } else { %>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/logout">লগআউট</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Category nav (mega menu, giftallbd.com style) -->
  <nav class="category-nav">
    <div class="container">
      <ul class="nav-list">
        <li><a href="/" class="nav-home-link"><i class="bi bi-house-door-fill"></i></a></li>
        <li class="mega-parent" id="allCatToggle">
          <span class="nav-toggle"><i class="bi bi-list"></i> সকল ক্যাটাগরি <i class="bi bi-chevron-down mega-caret"></i></span>
          <div class="mega-panel all-cat-panel">
            <div class="mega-panel-grid">
              <% navCategories.forEach(function (cat) { %>
                <div class="mega-col">
                  <a href="/category/<%= cat.slug %>" class="mega-col-title"><%= cat.name %></a>
                  <% if (cat.children && cat.children.length) { %>
                    <ul>
                      <% cat.children.forEach(function (sub) { %>
                        <li><a href="/category/<%= sub.slug %>"><%= sub.name %></a></li>
                      <% }); %>
                    </ul>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        </li>

        <% navCategories.forEach(function (cat) { %>
          <% if (cat.children && cat.children.length) { %>
            <li class="mega-parent">
              <a href="/category/<%= cat.slug %>"><%= cat.name %></a>
              <span class="mega-toggle"><i class="bi bi-chevron-down"></i></span>
              <div class="mega-panel">
                <div class="mega-panel-flat">
                  <% cat.children.forEach(function (sub) { %>
                    <a class="mega-sub-item" href="/category/<%= sub.slug %>">
                      <img src="<%= categoryImageUrl(sub.image) %>" alt="<%= sub.name %>">
                      <span><%= sub.name %></span>
                    </a>
                  <% }); %>
                </div>
              </div>
            </li>
          <% } else { %>
            <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
          <% } %>
        <% }); %>
      </ul>
    </div>
  </nav>
</header>

<div class="container">
  <% flashes.forEach(function (f) { %>
    <div class="alert alert-<%= f.type %> alert-dismissible fade show mt-3" role="alert">
      <%= f.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% }); %>
</div>
