<%
  const hasVariants = !!(p.hasVariants && p.variants && p.variants.length);
  const displayPrice = hasVariants ? p.startingPrice() : p.effectivePrice;
  const rating = p.rating || 4.5;
%>
<div class="product-card">
  <a href="/product/<%= p.slug %>" class="product-card-img">
    <img src="<%= productImageUrl(p.image) %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/images/product-placeholder.svg'">
    <% if (!hasVariants && p.hasSale) { %><span class="badge-discount">-<%= p.discountPercent %>%</span><% } %>
    <% if (p.isFlashSale) { %><span class="badge-flash"><i class="bi bi-lightning-fill"></i></span><% } %>
  </a>
  <div class="product-card-body">
    <a href="/product/<%= p.slug %>" class="product-title"><%= p.name %></a>
    <div class="product-rating">
      <% for (let i = 1; i <= 5; i++) { %>
        <% if (i <= Math.round(rating)) { %><i class="bi bi-star-fill"></i><% } else { %><i class="bi bi-star"></i><% } %>
      <% } %>
      <span class="rating-num">(<%= rating.toFixed(1) %>)</span>
    </div>
    <div class="product-price">
      <% if (hasVariants) { %>
        <span class="text-muted small">থেকে</span> <span class="price-now"><%= currency(displayPrice) %></span>
      <% } else if (p.hasSale) { %>
        <span class="price-now"><%= currency(p.effectivePrice) %></span>
        <span class="price-old"><%= currency(p.price) %></span>
      <% } else { %>
        <span class="price-now"><%= currency(p.effectivePrice) %></span>
      <% } %>
    </div>
    <div class="product-actions">
      <% if (hasVariants) { %>
        <a href="/product/<%= p.slug %>" class="btn btn-buy-now w-100">ভ্যারিয়েন্ট দেখুন</a>
      <% } else { %>
        <button class="btn btn-add-cart" data-add-cart data-id="<%= p._id %>">আরো কিনুন</button>
        <a href="/checkout?buyNow=<%= p._id %>" class="btn btn-buy-now">এখনই কিনুন</a>
      <% } %>
    </div>
  </div>
</div>
