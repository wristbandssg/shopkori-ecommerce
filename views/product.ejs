<%
  const rating = product.rating || 4.5;
  const hasVariants = !!(product.hasVariants && product.variants && product.variants.length);
  const showPurchaseBlock = hasVariants || product.stock > 0;
  const currencySymbol = settings.currency_symbol || '৳';
  const minOrderQty = Math.max(1, product.minOrderQty || 1);
  const maxOrderQty = product.maxOrderQty || null;
  const qtyCap = (stock) => {
    let cap = product.overselling ? 99999 : Math.max(stock, minOrderQty);
    if (maxOrderQty) cap = Math.min(cap, maxOrderQty);
    return cap;
  };
%>
<%- include('partials/header') %>

<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">হোম</a></li>
      <li class="breadcrumb-item active"><%= product.name %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <div class="col-md-5">
      <div class="product-gallery">
        <img id="mainProductImage" src="<%= productImageUrl(product.image) %>" class="img-fluid rounded" alt="<%= product.name %>" onerror="this.src='/images/product-placeholder.svg'">
        <% if (product.galleryImage) { %>
          <div class="product-thumbs mt-2 d-flex gap-2">
            <img src="<%= productImageUrl(product.image) %>" class="product-thumb-item active" data-full="<%= productImageUrl(product.image) %>">
            <img src="<%= productImageUrl(product.galleryImage) %>" class="product-thumb-item" data-full="<%= productImageUrl(product.galleryImage) %>">
          </div>
        <% } %>
        <% if (product.videoEmbed && product.videoPosition === 'top') { %>
          <div class="ratio ratio-16x9 mt-3">
            <iframe src="<%= product.videoEmbed %>" title="Product video" allowfullscreen></iframe>
          </div>
        <% } %>
      </div>
    </div>
    <div class="col-md-7">
      <h1 class="product-detail-title"><%= product.name %></h1>
      <div class="product-rating mb-2">
        <% for (let i = 1; i <= 5; i++) { %>
          <% if (i <= Math.round(rating)) { %><i class="bi bi-star-fill"></i><% } else { %><i class="bi bi-star"></i><% } %>
        <% } %>
        <span class="rating-num">(<%= rating.toFixed(1) %>) · SKU: <%= product.sku || 'N/A' %><% if (product.weight) { %> · ওজন: <%= product.weight %> কেজি<% } %></span>
        <% if (product.condition && product.condition !== 'new') { %>
          <span class="badge bg-secondary ms-2"><%= product.condition === 'used' ? 'ব্যবহৃত' : 'রিফার্বিশড' %></span>
        <% } %>
        <% if (product.availability === 'pre_order') { %>
          <span class="badge bg-info ms-2">প্রি-অর্ডার</span>
        <% } %>
      </div>

      <div class="product-detail-price mb-2">
        <% if (hasVariants) { %>
          <span class="text-muted small">থেকে</span>
          <span class="price-now big" id="priceNowEl"><%= currency(product.startingPrice()) %></span>
          <span class="price-old big" id="priceOldEl" style="display:none"></span>
          <span class="badge-discount static" id="discountBadgeEl" style="display:none"></span>
        <% } else if (product.hasSale) { %>
          <span class="price-now big" id="priceNowEl"><%= currency(product.effectivePrice) %></span>
          <span class="price-old big" id="priceOldEl"><%= currency(product.price) %></span>
          <span class="badge-discount static" id="discountBadgeEl">-<%= product.discountPercent %>%</span>
        <% } else { %>
          <span class="price-now big" id="priceNowEl"><%= currency(product.effectivePrice) %></span>
          <span class="price-old big" id="priceOldEl" style="display:none"></span>
          <span class="badge-discount static" id="discountBadgeEl" style="display:none"></span>
        <% } %>
      </div>

      <% if (product.offerDescription && product.offerDescription.text) { %>
        <div class="alert alert-warning py-2 px-3 mb-3"><i class="bi bi-tag-fill"></i> <%= product.offerDescription.text %></div>
      <% } %>

      <p class="product-short-desc"><%= product.shortDescription %></p>

      <% if (hasVariants) { %>
        <div class="mb-3">
          <label class="form-label fw-bold d-block">ভ্যারিয়েন্ট নির্বাচন করুন<% if (product.variantMandatory) { %> *<% } %></label>
          <div class="variant-options" id="variantOptions">
            <% if (!product.variantMandatory) { %>
              <button type="button" class="variant-chip"
                data-variant-id=""
                data-price="<%= product.effectivePrice %>"
                data-base-price="<%= product.price %>"
                data-stock="<%= product.stock %>"
                data-has-sale="<%= product.hasSale %>">Standard</button>
            <% } %>
            <% product.variants.forEach(function (v) {
                 const base = v.price != null ? v.price : product.price;
                 const vPrice = (v.salePrice && v.salePrice < base) ? v.salePrice : base;
                 const vHasSale = !!(v.salePrice && v.salePrice < base);
                 const outOfStock = v.stock <= 0 && !product.overselling;
            %>
              <button type="button" class="variant-chip <%= outOfStock ? 'disabled' : '' %>"
                data-variant-id="<%= v._id %>"
                data-price="<%= vPrice %>"
                data-base-price="<%= base %>"
                data-stock="<%= v.stock %>"
                data-has-sale="<%= vHasSale %>"
                <%= outOfStock ? 'disabled' : '' %>>
                <%= v.label %><% if (outOfStock) { %> (স্টক শেষ)<% } %>
              </button>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="stock-status mb-3" id="stockStatusBox">
        <% if (hasVariants) { %>
          <span id="stockStatusText" class="text-muted"><i class="bi bi-info-circle"></i> স্টক দেখতে একটি ভ্যারিয়েন্ট নির্বাচন করুন</span>
        <% } else if (product.stock > 0) { %>
          <span id="stockStatusText" class="text-success"><i class="bi bi-check-circle-fill"></i> স্টকে আছে (<%= product.stock %> পিস)</span>
        <% } else { %>
          <span id="stockStatusText" class="text-danger"><i class="bi bi-x-circle-fill"></i> স্টক শেষ</span>
        <% } %>
      </div>

      <% if (showPurchaseBlock) { %>
      <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
        <div class="qty-input">
          <button type="button" class="qty-btn" data-qty-minus>-</button>
          <input type="number" id="qtyInput" value="<%= minOrderQty %>" min="<%= minOrderQty %>" max="<%= hasVariants ? minOrderQty : qtyCap(product.stock) %>">
          <button type="button" class="qty-btn" data-qty-plus>+</button>
        </div>
        <% if (minOrderQty > 1 || maxOrderQty) { %>
          <small class="text-muted d-block w-100">
            <% if (minOrderQty > 1) { %>সর্বনিম্ন <%= minOrderQty %> টি<% } %>
            <% if (minOrderQty > 1 && maxOrderQty) { %>, <% } %>
            <% if (maxOrderQty) { %>সর্বোচ্চ <%= maxOrderQty %> টি<% } %>
          </small>
        <% } %>
        <button class="btn btn-add-cart px-4" id="addCartBtn" data-add-cart data-id="<%= product._id %>" data-variant-id="" data-qty-source="qtyInput" <%= (hasVariants && product.variantMandatory) ? 'disabled' : '' %>>
          <i class="bi bi-cart-plus"></i> কার্টে যোগ করুন
        </button>
        <a href="/checkout?buyNow=<%= product._id %>" id="buyNowBtn" class="btn btn-buy-now px-4 <%= (hasVariants && product.variantMandatory) ? 'disabled' : '' %>" <%= (hasVariants && product.variantMandatory) ? 'aria-disabled="true" tabindex="-1"' : '' %>>এখনই কিনুন</a>
      </div>
      <% } %>

      <div class="delivery-info">
        <div><i class="bi bi-truck"></i> ঢাকায় সেম ডে ডেলিভারি, ঢাকার বাইরে ২৪-৪৮ ঘণ্টা</div>
        <div><i class="bi bi-shield-check"></i> ১০০% অরিজিনাল প্রোডাক্টের নিশ্চয়তা</div>
        <div><i class="bi bi-cash-coin"></i> ক্যাশ অন ডেলিভারি সুবিধা আছে</div>
      </div>

      <% if (product.tags && product.tags.length) { %>
        <div class="product-tags mt-3">
          <% product.tags.forEach(function (t) { %>
            <a href="/search?q=<%= encodeURIComponent(t) %>" class="tag-pill">#<%= t %></a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="row mt-5">
    <div class="col-12">
      <ul class="nav nav-tabs" id="productTabs">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#desc">বিস্তারিত বিবরণ</button></li>
      </ul>
      <div class="tab-content border border-top-0 p-4 mb-4">
        <div class="tab-pane fade show active" id="desc">
          <% if (product.videoEmbed && product.videoPosition === 'top') { %>
            <!-- video already shown in gallery above -->
          <% } %>
          <%- product.description %>
          <% if (product.videoEmbed && product.videoPosition === 'bottom') { %>
            <div class="ratio ratio-16x9 mt-3">
              <iframe src="<%= product.videoEmbed %>" title="Product video" allowfullscreen></iframe>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% if (related.length) { %>
  <div class="section-heading">
    <h2>সম্পর্কিত প্রোডাক্ট</h2>
  </div>
  <div class="product-grid">
    <% related.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
  </div>
  <% } %>
</div>

<% if (hasVariants) { %>
<script>
(function () {
  var chips = document.querySelectorAll('.variant-chip');
  var priceNowEl = document.getElementById('priceNowEl');
  var priceOldEl = document.getElementById('priceOldEl');
  var discountBadgeEl = document.getElementById('discountBadgeEl');
  var stockTextEl = document.getElementById('stockStatusText');
  var qtyInput = document.getElementById('qtyInput');
  var addCartBtn = document.getElementById('addCartBtn');
  var buyNowBtn = document.getElementById('buyNowBtn');
  var overselling = <%= product.overselling ? 'true' : 'false' %>;
  var productId = '<%= product._id %>';
  var currencySymbol = '<%= currencySymbol %>';
  var minQty = <%= minOrderQty %>;
  var maxQty = <%= maxOrderQty || 'null' %>;

  function formatCurrency(n) {
    return currencySymbol + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function selectChip(chip) {
    chips.forEach(function (c) { c.classList.remove('active'); });
    chip.classList.add('active');

    var price = parseFloat(chip.getAttribute('data-price'));
    var basePrice = parseFloat(chip.getAttribute('data-base-price'));
    var stock = parseInt(chip.getAttribute('data-stock'), 10) || 0;
    var hasSale = chip.getAttribute('data-has-sale') === 'true';
    var variantId = chip.getAttribute('data-variant-id') || '';

    if (priceNowEl) priceNowEl.textContent = formatCurrency(price);
    if (priceOldEl) {
      priceOldEl.style.display = hasSale ? 'inline' : 'none';
      if (hasSale) priceOldEl.textContent = formatCurrency(basePrice);
    }
    if (discountBadgeEl) {
      if (hasSale && basePrice > 0) {
        discountBadgeEl.style.display = 'inline-block';
        discountBadgeEl.textContent = '-' + Math.round(((basePrice - price) / basePrice) * 100) + '%';
      } else {
        discountBadgeEl.style.display = 'none';
      }
    }

    var purchasable = stock > 0 || overselling;
    if (stockTextEl) {
      if (purchasable) {
        stockTextEl.innerHTML = '<i class="bi bi-check-circle-fill"></i> স্টকে আছে' + (stock > 0 ? ' (' + stock + ' পিস)' : '');
        stockTextEl.className = 'text-success';
      } else {
        stockTextEl.innerHTML = '<i class="bi bi-x-circle-fill"></i> স্টক শেষ';
        stockTextEl.className = 'text-danger';
      }
    }

    if (qtyInput) {
      var cap = overselling ? 99999 : Math.max(stock, minQty);
      if (maxQty) cap = Math.min(cap, maxQty);
      qtyInput.min = minQty;
      qtyInput.max = cap;
      var curVal = parseInt(qtyInput.value, 10) || minQty;
      if (curVal > cap) qtyInput.value = cap;
      else if (curVal < minQty) qtyInput.value = minQty;
    }
    if (addCartBtn) {
      addCartBtn.setAttribute('data-variant-id', variantId);
      addCartBtn.disabled = !purchasable;
    }
    if (buyNowBtn) {
      if (purchasable) {
        buyNowBtn.classList.remove('disabled');
        buyNowBtn.removeAttribute('aria-disabled');
        buyNowBtn.removeAttribute('tabindex');
        buyNowBtn.href = '/checkout?buyNow=' + productId + (variantId ? '&variant=' + encodeURIComponent(variantId) : '');
      } else {
        buyNowBtn.classList.add('disabled');
        buyNowBtn.setAttribute('aria-disabled', 'true');
        buyNowBtn.setAttribute('tabindex', '-1');
        buyNowBtn.href = '#';
      }
    }
  }

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      if (chip.disabled) return;
      selectChip(chip);
    });
  });

  var standardChip = document.querySelector('.variant-chip[data-variant-id=""]');
  if (standardChip) selectChip(standardChip);
})();
</script>
<% } %>

<% if (product.galleryImage) { %>
<script>
document.querySelectorAll('.product-thumb-item').forEach(function (thumb) {
  thumb.addEventListener('click', function () {
    document.getElementById('mainProductImage').src = thumb.getAttribute('data-full');
    document.querySelectorAll('.product-thumb-item').forEach(function (t) { t.classList.remove('active'); });
    thumb.classList.add('active');
  });
});
</script>
<% } %>

<%- include('partials/footer') %>
