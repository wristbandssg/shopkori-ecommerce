<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/analytics" class="text-decoration-none">Analytics Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted"><%= meta.title %></span>
</nav>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
    <div>
      <label class="form-label">Start Date</label>
      <input type="date" name="from" class="form-control" value="<%= from %>">
    </div>
    <div>
      <label class="form-label">End Date</label>
      <input type="date" name="to" class="form-control" value="<%= to %>">
    </div>
    <button class="btn btn-brand">Filter</button>
  </form>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="admin-card">
      <h5>Revenue by Category</h5>
      <canvas id="topCategoryChart" height="220"></canvas>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="admin-card">
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Category</th><th>Units Sold</th><th>Revenue</th><th>Share</th></tr></thead>
          <tbody>
            <% rows.forEach(function (r) { %>
              <tr>
                <td><%= r._id %></td>
                <td><%= r.qty %></td>
                <td><%= currency(r.revenue) %></td>
                <td><%= totalRevenue > 0 ? Math.round((r.revenue / totalRevenue) * 100) : 0 %>%</td>
              </tr>
            <% }); %>
            <% if (!rows.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No sales in this period.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
new Chart(document.getElementById('topCategoryChart'), {
  type: 'doughnut',
  data: {
    labels: <%- JSON.stringify(rows.map(function (r) { return r._id; })) %>,
    datasets: [{
      data: <%- JSON.stringify(rows.map(function (r) { return r.revenue; })) %>,
      backgroundColor: ['#1e3a5f','#d4a537','#4c8a7d','#c0554e','#7a6bab','#5b9bd5','#f4a460','#6b8e23'],
    }]
  },
  options: { plugins: { legend: { position: 'bottom' } } }
});
</script>

<%- include('partials/admin-footer') %>
