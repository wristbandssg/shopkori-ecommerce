<%
  const d = blogCategory || {};
  const isEdit = !!(blogCategory && blogCategory._id);
  const formAction = isEdit ? `/admin/blog/categories/${blogCategory._id}/edit` : '/admin/blog/categories/new';

  function toDatetimeLocal(dt) {
    if (!dt) return '';
    dt = new Date(dt);
    if (Number.isNaN(dt.getTime())) return '';
    const pad = (n) => String(n).padStart(2, '0');
    return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}T${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
  }
  const publishStatusValue = ['draft', 'published', 'scheduled'].includes(d.publishStatus) ? d.publishStatus : 'published';
  const publishAtLocalValue = toDatetimeLocal(d.publishAt);
%>
<%- include('partials/admin-header') %>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (err) { %><li><%= err %></li><% }); %></ul></div>
<% } %>

<form method="post" action="<%= formAction %>" enctype="multipart/form-data" id="blogCategoryForm">
  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-journal-bookmark-fill text-brand"></i> <%= isEdit ? 'Edit Blog Category' : 'Add New Blog Category' %></h4>
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <a href="/admin/blog/categories" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> Save</button>
    </div>
  </div>

  <div class="row g-3">
    <!-- =====================================================
         MAIN COLUMN — the category page's content + SEO
         ===================================================== -->
    <div class="col-lg-8">

      <!-- ---------- Basic Information ---------- -->
      <div class="admin-card mb-3">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Category Name *</label>
            <input type="text" name="name" class="form-control" required value="<%= d.name || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Slug <small class="text-muted">(auto if blank)</small></label>
            <input type="text" name="slug" class="form-control" value="<%= d.slug || '' %>">
          </div>
        </div>
      </div>

      <!-- ---------- Category Page Content (SEO) — same fields as Product Category ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-file-earmark-richtext"></i> Category Page Content</h5>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Page Title</label>
            <input type="text" name="pageTitle" class="form-control" value="<%= d.pageTitle || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Short Intro</label>
            <textarea name="shortDescription" class="form-control" rows="3"><%= d.shortDescription || '' %></textarea>
          </div>
          <div class="col-12">
            <label class="form-label">Content Below Posts</label>
            <%- include('partials/rich-editor', { idSuffix: 'blogcat', fieldName: 'description', initialContent: d.description || '' }) %>
          </div>
        </div>
      </div>

      <!-- ---------- SEO ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-search"></i> SEO</h5>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Meta Title</label>
            <input type="text" name="metaTitle" class="form-control" value="<%= d.metaTitle || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Meta Keywords</label>
            <input type="text" name="metaKeywords" class="form-control" value="<%= d.metaKeywords || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Meta Description</label>
            <input type="text" name="metaDescription" class="form-control" value="<%= d.metaDescription || '' %>">
          </div>
        </div>
      </div>

    </div>

    <!-- =====================================================
         SIDEBAR — status, order, image
         ===================================================== -->
    <div class="col-lg-4">

      <!-- ---------- Status ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-toggle2-on"></i> Status</h5>
        <div class="btn-group flex-wrap mb-2" role="group">
          <input type="radio" class="btn-check" name="publishStatus" id="bcPsDraft" value="draft" autocomplete="off" <%= publishStatusValue === 'draft' ? 'checked' : '' %>>
          <label class="btn btn-outline-primary btn-sm" for="bcPsDraft">Draft</label>
          <input type="radio" class="btn-check" name="publishStatus" id="bcPsPublished" value="published" autocomplete="off" <%= publishStatusValue === 'published' ? 'checked' : '' %>>
          <label class="btn btn-outline-primary btn-sm" for="bcPsPublished">Publish</label>
          <input type="radio" class="btn-check" name="publishStatus" id="bcPsScheduled" value="scheduled" autocomplete="off" <%= publishStatusValue === 'scheduled' ? 'checked' : '' %>>
          <label class="btn btn-outline-primary btn-sm" for="bcPsScheduled">Schedule</label>
        </div>
        <div id="bcPublishAtWrap" class="mb-1" style="<%= publishStatusValue === 'scheduled' ? '' : 'display:none' %>">
          <label class="form-label">Publish Date &amp; Time</label>
          <input type="datetime-local" name="publishAt" class="form-control" value="<%= publishAtLocalValue %>">
        </div>
      </div>

      <div class="admin-card mb-3">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Sort Order</label>
            <input type="number" name="sortOrder" class="form-control" value="<%= d.sortOrder !== undefined ? d.sortOrder : 0 %>">
          </div>
        </div>
      </div>

      <!-- ---------- Image ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-images"></i> Image</h5>
        <input type="file" name="image" class="form-control" accept="image/*">
        <% if (d.image) { %><img src="<%= categoryImageUrl(d.image) %>" class="admin-thumb mt-2"><% } %>
        <input type="text" name="imageAlt" class="form-control mt-2" placeholder="Alt text (for SEO & accessibility)" value="<%= d.imageAlt || '' %>">
      </div>

    </div>
  </div>

  <div class="mb-4">
    <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> Save</button>
    <a href="/admin/blog/categories" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>

<script>
  // ---- Publish status: show the Schedule date/time picker only when relevant ----
  (function () {
    var publishAtWrap = document.getElementById('bcPublishAtWrap');
    document.querySelectorAll('input[name="publishStatus"]').forEach(function (r) {
      r.addEventListener('change', function () {
        publishAtWrap.style.display = document.getElementById('bcPsScheduled').checked ? '' : 'none';
      });
    });
  })();
</script>

<%- include('partials/admin-footer') %>
