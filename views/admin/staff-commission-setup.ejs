<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/staff" class="text-decoration-none">Staff Setup</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Staff Commission Setup</span>
</nav>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
  </div>
<% } %>

<div class="admin-card mb-3">
  <h6 class="mb-3">Commission Setups</h6>
  <button type="button" class="btn btn-brand w-100 mb-3" data-bs-toggle="modal" data-bs-target="#addCommissionModal">Create Commission Setup</button>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Employee Type</th><th>Commission Rate</th><th>After Courier</th><th>After Delivered</th><th>Actions</th></tr></thead>
      <tbody>
        <% setups.forEach(function (s) { %>
          <tr>
            <td><%= s.role ? s.role.name : '—' %></td>
            <td><%= s.commissionRate %>%</td>
            <td><span class="badge bg-<%= s.afterCourier ? 'success' : 'secondary' %>"><%= s.afterCourier ? 'Yes' : 'No' %></span></td>
            <td><span class="badge bg-<%= s.afterDelivered ? 'success' : 'secondary' %>"><%= s.afterDelivered ? 'Yes' : 'No' %></span></td>
            <td class="text-nowrap">
              <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editCommission<%= s._id %>"><i class="bi bi-pencil"></i></button>
              <a href="/admin/staff/commission-setup/delete/<%= s._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this commission setup?')"><i class="bi bi-trash"></i></a>
            </td>
          </tr>

          <div class="modal fade" id="editCommission<%= s._id %>" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <form method="post" action="/admin/staff/commission-setup">
                  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                  <input type="hidden" name="id" value="<%= s._id %>">
                  <div class="modal-header"><h5 class="modal-title">Edit Commission Setup</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Employee Type*</label>
                      <select name="role" class="form-select" required>
                        <option value="">— Select Role —</option>
                        <% roles.forEach(function (r) { %><option value="<%= r._id %>" <%= s.role && String(s.role._id) === String(r._id) ? 'selected' : '' %>><%= r.name %></option><% }); %>
                      </select>
                    </div>
                    <div class="mb-3"><label class="form-label">Commission Rate (%)*</label><input type="number" step="0.01" min="0" name="commissionRate" class="form-control" value="<%= s.commissionRate %>" required></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="afterCourier" value="1" id="afterCourier<%= s._id %>" <%= s.afterCourier ? 'checked' : '' %>><label class="form-check-label" for="afterCourier<%= s._id %>">After Courier</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="afterDelivered" value="1" id="afterDelivered<%= s._id %>" <%= s.afterDelivered ? 'checked' : '' %>><label class="form-check-label" for="afterDelivered<%= s._id %>">After Delivered</label></div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-brand">Save</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
        <% if (!setups.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No entries found</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <p class="form-text mb-0">Commission Rate is a % of each order's total, credited once when the order reaches a milestone turned on below (Courier and/or Delivered). "Employee Type" here means the staff's Role — see Staff &gt; Roles.</p>
</div>

<!-- Create Commission Setup modal -->
<div class="modal fade" id="addCommissionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/admin/staff/commission-setup">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <div class="modal-header"><h5 class="modal-title">Create Commission Setup</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Employee Type*</label>
            <select name="role" class="form-select" required>
              <option value="">— Select Role —</option>
              <% roles.forEach(function (r) { %><option value="<%= r._id %>"><%= r.name %></option><% }); %>
            </select>
          </div>
          <div class="mb-3"><label class="form-label">Commission Rate (%)*</label><input type="number" step="0.01" min="0" name="commissionRate" class="form-control" placeholder="e.g. 2.5" required></div>
          <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="afterCourier" value="1" id="afterCourierNew"><label class="form-check-label" for="afterCourierNew">After Courier</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" name="afterDelivered" value="1" id="afterDeliveredNew" checked><label class="form-check-label" for="afterDeliveredNew">After Delivered</label></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-brand">Create</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/admin-footer') %>
