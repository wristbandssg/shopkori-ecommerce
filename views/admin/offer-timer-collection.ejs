<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/offer" class="text-decoration-none">Offer Setting</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted"><%= adminPageTitle %></span>
</nav>

<form method="post" action="<%= postPath %>">
  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

  <div class="admin-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6 class="mb-0"><%= adminPageTitle %></h6>
      <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" role="switch" name="enabled" value="1" id="enabledSwitch" <%= card.enabled ? 'checked' : '' %>>
        <label class="form-check-label" for="enabledSwitch">Show/Hide</label>
      </div>
    </div>

    <%- include('partials/offer-products-card', { products: products, selected: card.products }) %>
  </div>

  <div class="admin-card mb-3">
    <div class="form-check form-switch mb-3">
      <input class="form-check-input" type="checkbox" role="switch" name="timerEnabled" value="1" id="timerEnabledSwitch" <%= card.timerEnabled ? 'checked' : '' %>>
      <label class="form-check-label" for="timerEnabledSwitch">Timer Off/On</label>
    </div>

    <div class="d-flex align-items-center gap-3 mb-4">
      <i class="bi bi-stopwatch fs-2 text-muted"></i>
      <div class="d-flex gap-4 text-center">
        <div><div class="fw-bold fs-5" id="cdDays">00</div><div class="small text-muted">Days</div></div>
        <div><div class="fw-bold fs-5" id="cdHours">00</div><div class="small text-muted">Hours</div></div>
        <div><div class="fw-bold fs-5" id="cdMin">00</div><div class="small text-muted">Min</div></div>
        <div><div class="fw-bold fs-5" id="cdSec">00</div><div class="small text-muted">Sec</div></div>
      </div>
    </div>

    <label class="form-label d-block">Select Timer Type</label>
    <div class="mb-3">
      <input type="radio" class="btn-check" name="timerType" id="timerTypeDays" value="days" autocomplete="off" <%= card.timerType !== 'hours' && card.timerType !== 'minutes' ? 'checked' : '' %>>
      <label class="btn btn-outline-primary btn-sm me-2" for="timerTypeDays">Days Only</label>
      <input type="radio" class="btn-check" name="timerType" id="timerTypeHours" value="hours" autocomplete="off" <%= card.timerType === 'hours' ? 'checked' : '' %>>
      <label class="btn btn-outline-primary btn-sm me-2" for="timerTypeHours">Hours Only</label>
      <input type="radio" class="btn-check" name="timerType" id="timerTypeMinutes" value="minutes" autocomplete="off" <%= card.timerType === 'minutes' ? 'checked' : '' %>>
      <label class="btn btn-outline-primary btn-sm" for="timerTypeMinutes">Minutes Only</label>
    </div>

    <label class="form-label">Duration</label>
    <select name="duration" id="durationSelect" class="form-select mb-1" style="max-width:300px"></select>
    <p class="form-text">How far from the moment you hit "Save Now" the countdown ends. (Original preset list — no exact values were shown in the design.)</p>

    <label class="form-label mt-3 d-block">Choose your Timer color:</label>
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label small">Text color</label>
        <input type="color" name="textColor" class="form-control form-control-color w-100" value="<%= card.textColor || '#ffffff' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label small">Border color</label>
        <input type="color" name="borderColor" class="form-control form-control-color w-100" value="<%= card.borderColor || '#EC0E8C' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label small">Background color</label>
        <input type="color" name="backgroundColor" class="form-control form-control-color w-100" value="<%= card.backgroundColor || '#EC0E8C' %>">
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-brand">Save Now</button>
</form>

<script>
(function () {
  var DURATIONS = {
    days: [1, 3, 5, 7, 10, 15, 20, 30, 40, 45, 60],
    hours: [1, 3, 6, 12, 24, 48, 72],
    minutes: [5, 10, 15, 30, 45, 60],
  };
  var UNIT_MS = { days: 86400000, hours: 3600000, minutes: 60000 };
  var savedType = <%- JSON.stringify(card.timerType || 'days') %>;
  var savedDuration = <%- JSON.stringify(card.duration || 0) %>;
  var savedEndsAt = <%- JSON.stringify(card.endsAt ? new Date(card.endsAt).toISOString() : null) %>;
  var savedTimerEnabled = <%- JSON.stringify(!!card.timerEnabled) %>;

  var durationSelect = document.getElementById('durationSelect');
  function currentType() {
    var el = document.querySelector('input[name="timerType"]:checked');
    return el ? el.value : 'days';
  }
  function populateDuration() {
    var type = currentType();
    var opts = DURATIONS[type] || DURATIONS.days;
    durationSelect.innerHTML = opts.map(function (v) {
      return '<option value="' + v + '">' + v + ' ' + type.charAt(0).toUpperCase() + type.slice(1) + '</option>';
    }).join('');
    if (type === savedType && opts.indexOf(savedDuration) !== -1) durationSelect.value = savedDuration;
  }
  document.querySelectorAll('input[name="timerType"]').forEach(function (r) {
    r.addEventListener('change', populateDuration);
  });
  populateDuration();

  var cdDays = document.getElementById('cdDays'), cdHours = document.getElementById('cdHours'), cdMin = document.getElementById('cdMin'), cdSec = document.getElementById('cdSec');
  function targetTime() {
    // Prefer the real saved endsAt if it's still in the future and the
    // current selection still matches what was saved; otherwise preview
    // "now + currently selected duration".
    if (savedTimerEnabled && savedEndsAt && new Date(savedEndsAt).getTime() > Date.now() && currentType() === savedType && parseInt(durationSelect.value, 10) === savedDuration) {
      return new Date(savedEndsAt).getTime();
    }
    var unitMs = UNIT_MS[currentType()] || UNIT_MS.days;
    return Date.now() + (parseInt(durationSelect.value, 10) || 0) * unitMs;
  }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function tick() {
    var diff = Math.max(0, targetTime() - Date.now());
    cdDays.textContent = pad(Math.floor(diff / 86400000));
    cdHours.textContent = pad(Math.floor((diff % 86400000) / 3600000));
    cdMin.textContent = pad(Math.floor((diff % 3600000) / 60000));
    cdSec.textContent = pad(Math.floor((diff % 60000) / 1000));
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

<%- include('partials/admin-footer') %>
