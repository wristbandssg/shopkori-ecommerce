<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/settings" class="text-decoration-none">Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Page Builder Settings</span>
</nav>

<div class="admin-card mb-3">
  <h5 class="mb-3"><i class="bi bi-file-earmark-plus"></i> <%= editPage ? 'Edit Page' : 'Add New Page' %></h5>
  <% if (editPage) { %>
    <div class="alert alert-light border small mb-3">
      <i class="bi bi-globe"></i> Live at <a href="/page/<%= editPage.slug %>" target="_blank">/page/<%= editPage.slug %></a><% if (!editPage.status) { %> — currently <strong>inactive</strong>, so this link 404s until you check "Active" below.<% } %>
    </div>
  <% } %>
  <form method="post" id="pageBuilderForm" action="<%= editPage ? ('/admin/settings/page-builder/' + editPage._id + '/edit') : '/admin/settings/page-builder' %>" enctype="multipart/form-data">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label">Page Slug *</label>
        <input type="text" name="slug" class="form-control" placeholder="e.g. about-us" value="<%= editPage ? editPage.slug : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Page Name *</label>
        <input type="text" name="name" class="form-control" value="<%= editPage ? editPage.name : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Page Title *</label>
        <input type="text" name="title" class="form-control" value="<%= editPage ? editPage.title : '' %>" required>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Page Content</label>
      <%- include('partials/rich-editor', { idSuffix: 'pb', fieldName: 'content', initialContent: editPage ? (editPage.content || '') : '', internalLinkGroups: internalLinkGroups }) %>
    </div>

    <div class="mb-3">
      <label class="form-label">Image <small class="text-muted">(optional)</small></label>
      <input type="file" name="image" class="form-control" accept="image/*">
      <% if (editPage && editPage.image) { %><img src="<%= productImageUrl(editPage.image) %>" class="admin-thumb mt-2"><% } %>
      <input type="text" name="imageAlt" class="form-control mt-2" placeholder="Alt text (for SEO & accessibility)" value="<%= editPage ? (editPage.imageAlt || '') : '' %>">
    </div>

    <hr>
    <h6><i class="bi bi-search"></i> SEO</h6>
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label">Meta Title</label>
        <input type="text" name="metaTitle" class="form-control" value="<%= editPage ? (editPage.metaTitle || '') : '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Meta Keywords</label>
        <input type="text" name="metaKeywords" class="form-control" value="<%= editPage ? (editPage.metaKeywords || '') : '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Meta Description</label>
        <input type="text" name="metaDescription" class="form-control" value="<%= editPage ? (editPage.metaDescription || '') : '' %>">
      </div>
    </div>

    <% if (editPage) { %>
      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" name="status" id="pbStatus" <%= editPage.status ? 'checked' : '' %>>
        <label class="form-check-label" for="pbStatus">Active</label>
      </div>
    <% } %>

    <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> <%= editPage ? 'Update Page' : 'Save Page' %></button>
    <% if (editPage) { %><a href="/admin/settings/page-builder" class="btn btn-outline-secondary">Cancel</a><% } %>
  </form>
</div>

<div class="admin-card">
  <h5 class="mb-3"><i class="bi bi-files"></i> Page List</h5>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Slug</th><th>Page Name</th><th>Title</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% customPages.forEach(function (p) { %>
          <tr>
            <td><a href="/page/<%= p.slug %>" target="_blank"><code><%= p.slug %></code></a></td>
            <td><%= p.name %></td>
            <td><%= p.title %></td>
            <td><span class="badge bg-<%= p.status ? 'success' : 'secondary' %>"><%= p.status ? 'Active' : 'Inactive' %></span></td>
            <td class="text-nowrap">
              <a href="/admin/settings/page-builder/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <a href="/admin/settings/page-builder/delete/<%= p._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this page?" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }); %>
        <% if (!customPages.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No pages found. Create one above!</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
