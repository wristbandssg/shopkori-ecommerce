<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/settings" class="text-decoration-none">Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Page Builder Settings</span>
</nav>

<div class="admin-card mb-3">
  <h5 class="mb-3"><i class="bi bi-file-earmark-plus"></i> <%= editPage ? 'Edit Page' : 'Add New Page' %></h5>
  <form method="post" id="pageBuilderForm" action="<%= editPage ? ('/admin/settings/page-builder/' + editPage._id + '/edit') : '/admin/settings/page-builder' %>">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label">Page Slug *</label>
        <input type="text" name="slug" class="form-control" placeholder="e.g. about-us" value="<%= editPage ? editPage.slug : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Page Name *</label>
        <input type="text" name="name" class="form-control" value="<%= editPage ? editPage.name : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Page Title *</label>
        <input type="text" name="title" class="form-control" value="<%= editPage ? editPage.title : '' %>" required>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Page Content</label>
      <div class="custom-editor" id="pbEditorWrap">
        <div class="custom-editor-toolbar" id="pbToolbar">
          <button type="button" data-cmd="bold" title="Bold"><i class="bi bi-type-bold"></i></button>
          <button type="button" data-cmd="italic" title="Italic"><i class="bi bi-type-italic"></i></button>
          <button type="button" data-cmd="underline" title="Underline"><i class="bi bi-type-underline"></i></button>
          <button type="button" data-cmd="strikeThrough" title="Strikethrough"><i class="bi bi-type-strikethrough"></i></button>
          <span class="custom-editor-sep"></span>
          <button type="button" data-cmd="formatBlock" data-value="H2" title="Heading"><i class="bi bi-type-h2"></i></button>
          <button type="button" data-cmd="formatBlock" data-value="H3" title="Subheading"><i class="bi bi-type-h3"></i></button>
          <button type="button" data-cmd="formatBlock" data-value="P" title="Paragraph">¶</button>
          <span class="custom-editor-sep"></span>
          <button type="button" data-cmd="insertUnorderedList" title="Bullet list"><i class="bi bi-list-ul"></i></button>
          <button type="button" data-cmd="insertOrderedList" title="Numbered list"><i class="bi bi-list-ol"></i></button>
          <button type="button" data-cmd="formatBlock" data-value="BLOCKQUOTE" title="Quote"><i class="bi bi-quote"></i></button>
          <span class="custom-editor-sep"></span>
          <button type="button" id="pbLinkBtn" title="Insert link"><i class="bi bi-link-45deg"></i></button>
          <button type="button" data-cmd="unlink" title="Remove link"><i class="bi bi-link"></i></button>
          <span class="custom-editor-sep"></span>
          <button type="button" data-cmd="removeFormat" title="Clear formatting"><i class="bi bi-eraser"></i></button>
        </div>
        <div class="custom-editor-body" id="pbEditor" contenteditable="true"><%- editPage ? (editPage.content || '') : '' %></div>
      </div>
      <textarea name="content" id="pbContent" style="display:none"><%= editPage ? (editPage.content || '') : '' %></textarea>
    </div>

    <% if (editPage) { %>
      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" name="status" id="pbStatus" <%= editPage.status ? 'checked' : '' %>>
        <label class="form-check-label" for="pbStatus">Active</label>
      </div>
    <% } %>

    <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> <%= editPage ? 'Update Page' : 'Save Page' %></button>
    <% if (editPage) { %><a href="/admin/settings/page-builder" class="btn btn-outline-secondary">Cancel</a><% } %>
  </form>
</div>

<div class="admin-card">
  <h5 class="mb-3"><i class="bi bi-files"></i> Page List</h5>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Slug</th><th>Page Name</th><th>Title</th><th>Action</th></tr></thead>
      <tbody>
        <% customPages.forEach(function (p) { %>
          <tr>
            <td><code><%= p.slug %></code></td>
            <td><%= p.name %></td>
            <td><%= p.title %></td>
            <td class="text-nowrap">
              <a href="/admin/settings/page-builder/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <a href="/admin/settings/page-builder/delete/<%= p._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this page?" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }); %>
        <% if (!customPages.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No pages found. Create one above!</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  (function () {
    var toolbar = document.getElementById('pbToolbar');
    var editor = document.getElementById('pbEditor');
    var hidden = document.getElementById('pbContent');
    var linkBtn = document.getElementById('pbLinkBtn');

    function exec(cmd, value) {
      editor.focus();
      var v = (cmd === 'formatBlock' && value) ? '<' + value + '>' : (value || null);
      document.execCommand(cmd, false, v);
    }

    toolbar.querySelectorAll('button[data-cmd]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        exec(btn.getAttribute('data-cmd'), btn.getAttribute('data-value'));
      });
    });

    linkBtn.addEventListener('click', function () {
      var url = window.prompt('Enter link URL (e.g. https://example.com):');
      if (url) exec('createLink', url);
    });

    document.getElementById('pageBuilderForm').addEventListener('submit', function () {
      hidden.value = editor.innerHTML;
    });
  })();
});
</script>

<%- include('partials/admin-footer') %>
