<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Delivery Rate</span>
</nav>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="admin-card h-100">
      <h5><i class="bi bi-signpost-split"></i> Add Delivery Type</h5>
      <p class="text-muted small">Create a new delivery location or zone.</p>
      <form method="post" action="/admin/settings/delivery-charge/type">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control mb-3" placeholder="Enter Location Name" required>
        <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> Save</button>
      </form>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="admin-card h-100">
      <h5><i class="bi bi-cash-coin"></i> Add Delivery Rate</h5>
      <p class="text-muted small">Set a delivery charge for a location.</p>
      <form method="post" action="/admin/settings/delivery-charge/rate">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label">Location</label>
            <select name="location" class="form-select" required>
              <option value="">— Select —</option>
              <% zones.forEach(function (z) { %>
                <option value="<%= z._id %>"><%= z.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label">Amount</label>
            <input type="number" step="0.01" name="amount" class="form-control" placeholder="Enter Rate Amount" required>
          </div>
        </div>
        <button type="submit" class="btn btn-brand mt-3"><i class="bi bi-check2"></i> Save</button>
      </form>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="admin-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
          <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Delivery Locations</h5>
          <p class="text-muted small mb-0">All configured delivery types</p>
        </div>
        <span class="badge bg-light text-dark border"><%= zones.length %> Types</span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>#</th><th>Location</th><th>Action</th></tr></thead>
          <tbody>
            <% zones.forEach(function (z, i) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= z.name %></td>
                <td><a href="/admin/settings/delivery-charge/delete/<%= z._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this delivery location?" title="Delete"><i class="bi bi-trash"></i></a></td>
              </tr>
            <% }); %>
            <% if (!zones.length) { %><tr><td colspan="3" class="text-center text-muted">No delivery locations added yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="admin-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
          <h5 class="mb-0"><i class="bi bi-tag"></i> Delivery Rate</h5>
          <p class="text-muted small mb-0">Manage delivery charges per location</p>
        </div>
        <span class="badge bg-light text-dark border"><%= zones.filter(function (z) { return z.rate != null; }).length %> Locations</span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>#</th><th>Location</th><th>Rate</th><th>Action</th></tr></thead>
          <tbody>
            <% var priced = zones.filter(function (z) { return z.rate != null; }); %>
            <% priced.forEach(function (z, i) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= z.name %></td>
                <td><%= currency(z.rate) %></td>
                <td><a href="/admin/settings/delivery-charge/delete/<%= z._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this delivery rate?" title="Delete"><i class="bi bi-trash"></i></a></td>
              </tr>
            <% }); %>
            <% if (!priced.length) { %><tr><td colspan="4" class="text-center text-muted">No delivery rates added yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/admin-footer') %>
