<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/analytics" class="text-decoration-none">Analytics Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted"><%= meta.title %></span>
</nav>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
    <div>
      <label class="form-label">Start Date</label>
      <input type="date" name="from" class="form-control" value="<%= from %>">
    </div>
    <div>
      <label class="form-label">End Date</label>
      <input type="date" name="to" class="form-control" value="<%= to %>">
    </div>
    <button class="btn btn-brand">Filter</button>
  </form>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-4">
    <div class="stat-card">
      <div class="stat-icon" style="background:#337ab7;"><i class="bi bi-box-seam"></i></div>
      <div><span class="stat-value"><%= rows.length %></span><span class="stat-label">Products Sold</span></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="stat-icon" style="background:#2e9e5b;"><i class="bi bi-stack"></i></div>
      <div><span class="stat-value"><%= totalUnits %></span><span class="stat-label">Units Sold</span></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="stat-icon" style="background:#f0ad4e;"><i class="bi bi-cash-stack"></i></div>
      <div><span class="stat-value"><%= currency(totalRevenue) %></span><span class="stat-label">Total Revenue</span></div>
    </div>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Product</th><th>Orders</th><th>Units Sold</th><th>Revenue</th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="d-flex align-items-center gap-2"><img src="<%= productImageUrl(r._id.image) %>" class="admin-thumb"><%= r._id.name %></td>
            <td><%= r.orderCount %></td>
            <td><%= r.qtySold %></td>
            <td><%= currency(r.revenue) %></td>
          </tr>
        <% }); %>
        <% if (!rows.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No sales in this period.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
