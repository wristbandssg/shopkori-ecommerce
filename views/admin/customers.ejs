<%- include('partials/admin-header') %>

<div class="admin-card">
  <form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="q" class="form-control" placeholder="Search name, email or phone" value="<%= q %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
  </form>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Total Orders</th><th>Total Spent</th><th>Joined</th></tr></thead>
      <tbody>
        <% customers.forEach(function (c) { %>
          <tr>
            <td><%= c.name %></td>
            <td><%= c.email %></td>
            <td><%= c.phone %></td>
            <td><%= c.orderCount %></td>
            <td><%= currency(c.totalSpent) %></td>
            <td><%= new Date(c.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
          </tr>
        <% }); %>
        <% if (!customers.length) { %><tr><td colspan="6" class="text-center text-muted">No customers found.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
