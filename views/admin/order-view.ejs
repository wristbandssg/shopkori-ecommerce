<%- include('partials/admin-header') %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="admin-card">
      <h5>Order Items</h5>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
          <tbody>
            <% order.items.forEach(function (item) { %>
              <tr>
                <td class="d-flex align-items-center gap-2">
                  <img src="<%= productImageUrl(item.productImage) %>" class="admin-thumb">
                  <%= item.productName %>
                </td>
                <td><%= currency(item.price) %></td>
                <td><%= item.qty %></td>
                <td><%= currency(item.lineTotal) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr><td colspan="3" class="text-end">Subtotal</td><td><%= currency(order.subtotal) %></td></tr>
            <tr><td colspan="3" class="text-end">Delivery Charge</td><td><%= currency(order.shippingFee) %></td></tr>
            <tr><td colspan="3" class="text-end fw-bold">Grand Total</td><td class="fw-bold"><%= currency(order.total) %></td></tr>
          </tfoot>
        </table>
      </div>
    </div>

    <% if (typeof subOrders !== 'undefined' && subOrders.length) { %>
      <%
        const settleBadge = { pending: ['secondary', 'Pending (settles on delivery)'], settled: ['success', 'Settled'], reversed: ['danger', 'Reversed'], cancelled: ['dark', 'Cancelled'] };
      %>
      <div class="admin-card mt-4">
        <h5>Vendor Split</h5>
        <p class="form-text mt-0">This order includes vendor-owned products — split into a sub-order per vendor. Each vendor's earning is credited to their wallet automatically once this order's status is set to Delivered, and reversed if it's later Returned/Cancelled.</p>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Vendor</th><th>Items</th><th>Subtotal</th><th>Commission</th><th>Vendor Earning</th><th>Settlement</th></tr></thead>
            <tbody>
              <% subOrders.forEach(function (so) { %>
                <tr>
                  <td><a href="/admin/vendors/<%= so.vendor._id %>"><%= so.vendor.storeName %></a></td>
                  <td class="small"><%= so.items.map(function (i) { return i.productName + ' x' + i.qty; }).join(', ') %></td>
                  <td><%= currency(so.subtotal) %></td>
                  <td><%= currency(so.commissionAmount) %> (<%= so.commissionPercent %>%)</td>
                  <td><%= currency(so.vendorEarning) %></td>
                  <td><span class="badge bg-<%= settleBadge[so.settlementStatus][0] %>"><%= settleBadge[so.settlementStatus][1] %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <div class="admin-card mt-4">
      <h5>Activity Log</h5>
      <% if (order.activityLog && order.activityLog.length) { %>
        <ul class="list-unstyled mb-0">
          <% order.activityLog.slice().reverse().forEach(function (a) { %>
            <li class="mb-2 pb-2 border-bottom">
              <div><%= a.message %></div>
              <small class="text-muted"><%= new Date(a.at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="text-muted mb-0">No activity recorded yet.</p>
      <% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-card">
      <h5>Customer Info</h5>
      <p class="mb-1"><strong><%= order.customerName %></strong></p>
      <p class="mb-1"><i class="bi bi-telephone"></i> <%= order.customerPhone %></p>
      <% if (order.customerEmail) { %><p class="mb-1"><i class="bi bi-envelope"></i> <%= order.customerEmail %></p><% } %>
      <p class="mb-1"><i class="bi bi-geo-alt"></i> <%= order.shippingAddress %>, <%= order.shippingCity %></p>
      <% if (order.notes) { %><p class="mb-0"><strong>Note:</strong> <%= order.notes %></p><% } %>
      <p class="mb-0 mt-2"><span class="badge bg-light text-dark border"><%= order.source === 'manual' ? 'Manual Order' : 'Website Order' %></span></p>
    </div>

    <div class="admin-card mt-4">
      <h5>Update Order</h5>
      <form method="post" action="/admin/orders/<%= order._id %>">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label">Order Status</label>
          <select name="status" class="form-select">
            <% ORDER_STATUSES.forEach(function (s) { %>
              <option value="<%= s.value %>" <%= order.status === s.value ? 'selected' : '' %>><%= s.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Payment Status</label>
          <select name="paymentStatus" class="form-select">
            <% ['unpaid', 'pending', 'paid', 'failed', 'cancelled'].forEach(function (s) { %>
              <option value="<%= s %>" <%= order.paymentStatus === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }); %>
          </select>
        </div>
        <p class="small text-muted mb-3">Payment Method: <strong><%= order.paymentMethod.toUpperCase() %></strong><% if (order.transactionId) { %><br>Transaction ID: <code><%= order.transactionId %></code><% } %></p>

        <div class="mb-3">
          <label class="form-label">Courier</label>
          <select name="courier" class="form-select">
            <% COURIERS.forEach(function (c) { %>
              <option value="<%= c.value %>" <%= order.courier === c.value ? 'selected' : '' %>><%= c.label %></option>
            <% }); %>
          </select>
          <div class="form-text">For 3rd-party courier hand-off. For an in-house rider, use the Delivery Tracking card below instead.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">Courier Tracking ID</label>
          <input type="text" name="courierTrackingId" class="form-control" value="<%= order.courierTrackingId || '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label">Assigned Employee</label>
          <select name="assignedEmployee" class="form-select">
            <option value="">-- Unassigned --</option>
            <% employees.forEach(function (e) { %>
              <option value="<%= e._id %>" <%= order.assignedEmployee && String(order.assignedEmployee._id) === String(e._id) ? 'selected' : '' %>><%= e.fullName || e.username %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Admin Note</label>
          <textarea name="adminNote" class="form-control" rows="3"><%= order.adminNote || '' %></textarea>
        </div>
        <button type="submit" class="btn btn-brand w-100">Update</button>
      </form>
    </div>

    <div class="admin-card mt-4">
      <h5>Delivery Tracking</h5>
      <p class="small text-muted">This order's own in-house rider journey — separate from the 3rd-party Courier field above. Also drives the Manage Delivery lists (Delivery Man, Delivered Order, Clear Delivery, Cancelled Order).</p>
      <form method="post" action="/admin/orders/<%= order._id %>/delivery">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label">Delivery Status</label>
          <select name="deliveryStatus" class="form-select">
            <% DELIVERY_STATUSES.forEach(function (s) { %>
              <option value="<%= s.value %>" <%= order.delivery.status === s.value ? 'selected' : '' %>><%= s.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Delivery Man</label>
          <select name="deliveryMan" class="form-select">
            <option value="">-- Unassigned --</option>
            <% employees.forEach(function (e) { %>
              <option value="<%= e._id %>" <%= order.delivery.deliveryMan && String(order.delivery.deliveryMan._id || order.delivery.deliveryMan) === String(e._id) ? 'selected' : '' %>><%= e.fullName || e.username %></option>
            <% }); %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Rider Note</label>
          <textarea name="note" class="form-control" rows="2"><%= order.delivery.note || '' %></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label">Office Note</label>
          <textarea name="officeNote" class="form-control" rows="2"><%= order.delivery.officeNote || '' %></textarea>
        </div>
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" name="collected" id="deliveryCollected" <%= order.delivery.collected ? 'checked' : '' %>>
          <label class="form-check-label" for="deliveryCollected">Cash Collected (COD)</label>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" name="clearedToOffice" id="deliveryCleared" <%= order.delivery.clearedToOffice ? 'checked' : '' %>>
          <label class="form-check-label" for="deliveryCleared">Cleared to Office</label>
        </div>
        <% if (order.status === 'cancelled') { %>
          <div class="mb-3">
            <label class="form-label">Return Status</label>
            <select name="returnStatus" class="form-select">
              <option value="">-- Not started --</option>
              <% RETURN_STATUSES.forEach(function (s) { %>
                <option value="<%= s.value %>" <%= order.delivery.returnStatus === s.value ? 'selected' : '' %>><%= s.label %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <button type="submit" class="btn btn-brand w-100">Save Delivery Tracking</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/admin-footer') %>
