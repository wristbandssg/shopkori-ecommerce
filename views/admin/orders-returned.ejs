<%- include('partials/admin-header') %>

<div class="order-tabs mb-3">
  <a href="/admin/orders/returned?tab=not_received" class="order-tab <%= tab === 'not_received' ? 'active' : '' %>">Not Received <span class="order-tab-count"><%= countMap.not_received %></span></a>
  <a href="/admin/orders/returned?tab=received" class="order-tab <%= tab === 'received' ? 'active' : '' %>">Received <span class="order-tab-count"><%= countMap.received %></span></a>
</div>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 flex-wrap">
    <input type="hidden" name="tab" value="<%= tab %>">
    <input type="text" name="q" class="form-control" style="max-width:260px" placeholder="Search order#, name or phone" value="<%= q %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
  </form>
</div>

<div class="admin-card">
  <form method="post" id="returnedForm">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
      <div class="form-check">
        <input type="checkbox" class="form-check-input js-select-all" id="selectAllReturned">
        <label class="form-check-label" for="selectAllReturned">Select All</label>
      </div>
      <select name="returnReceived" class="form-select" style="max-width:200px">
        <option value="received">Mark as Received</option>
        <option value="not_received">Mark as Not Received</option>
      </select>
      <button type="submit" formaction="/admin/orders/bulk-return-status" class="btn btn-outline-primary btn-sm">Save</button>
    </div>

    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th></th><th>Order ID</th><th>Customer Info</th><th>Amount</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><input type="checkbox" class="form-check-input" name="ids" value="<%= o._id %>"></td>
              <td>
                <strong>#<%= o.orderNumber %></strong>
                <br><small class="text-muted"><%= new Date(o.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
              </td>
              <td><%= o.customerName %><br><small class="text-muted"><i class="bi bi-telephone"></i> <%= o.customerPhone %></small></td>
              <td><%= currency(o.total) %></td>
              <td><span class="badge bg-<%= o.returnReceived ? 'success' : 'secondary' %>"><%= o.returnReceived ? 'Received' : 'Not Received' %></span></td>
              <td><a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-primary">Details</a></td>
            </tr>
          <% }); %>
          <% if (!orders.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No returned orders found.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </form>
</div>

<%- include('partials/admin-footer') %>
