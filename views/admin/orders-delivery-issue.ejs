<%- include('partials/admin-header') %>

<div class="order-tabs mb-3">
  <a href="/admin/orders/delivery-issue?tab=unsolved" class="order-tab <%= tab === 'unsolved' ? 'active' : '' %>">Unsolved <span class="order-tab-count"><%= countMap.unsolved %></span></a>
  <a href="/admin/orders/delivery-issue?tab=solved" class="order-tab <%= tab === 'solved' ? 'active' : '' %>">Solved <span class="order-tab-count"><%= countMap.solved %></span></a>
  <a href="/admin/orders/delivery-issue?tab=cancel" class="order-tab <%= tab === 'cancel' ? 'active' : '' %>">Cancel <span class="order-tab-count"><%= countMap.cancel %></span></a>
  <a href="/admin/orders/delivery-issue?tab=partially_return" class="order-tab <%= tab === 'partially_return' ? 'active' : '' %>">Partially Return <span class="order-tab-count"><%= countMap.partially_return %></span></a>
</div>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 flex-wrap">
    <input type="hidden" name="tab" value="<%= tab %>">
    <input type="text" name="q" class="form-control" style="max-width:260px" placeholder="Search order#, name or phone" value="<%= q %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
  </form>
</div>

<div class="admin-card">
  <form method="post" id="deliveryIssueForm">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
      <div class="form-check">
        <input type="checkbox" class="form-check-input js-select-all" id="selectAllDeliveryIssue">
        <label class="form-check-label" for="selectAllDeliveryIssue">Select All</label>
      </div>
      <select name="deliveryIssueStatus" class="form-select" style="max-width:200px">
        <option value="unsolved">Unsolved</option>
        <option value="solved">Solved</option>
        <option value="cancel">Cancel</option>
        <option value="partially_return">Partially Return</option>
      </select>
      <button type="submit" formaction="/admin/orders/bulk-delivery-issue-status" class="btn btn-outline-primary btn-sm">Save</button>
    </div>

    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th></th><th>Order ID</th><th>Customer Info</th><th>Amount</th><th>Note</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% var ISSUE_LABELS = { unsolved: 'Unsolved', solved: 'Solved', cancel: 'Cancel', partially_return: 'Partially Return' }; %>
          <% var ISSUE_BADGE = { unsolved: 'danger', solved: 'success', cancel: 'secondary', partially_return: 'warning' }; %>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><input type="checkbox" class="form-check-input" name="ids" value="<%= o._id %>"></td>
              <td>
                <strong>#<%= o.orderNumber %></strong>
                <br><small class="text-muted"><%= new Date(o.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
              </td>
              <td><%= o.customerName %><br><small class="text-muted"><i class="bi bi-telephone"></i> <%= o.customerPhone %></small></td>
              <td><%= currency(o.total) %></td>
              <td><small class="text-muted"><%= o.adminNote || '—' %></small></td>
              <td><span class="badge bg-<%= ISSUE_BADGE[o.deliveryIssueStatus] %>"><%= ISSUE_LABELS[o.deliveryIssueStatus] %></span></td>
              <td><a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-primary">Details</a></td>
            </tr>
          <% }); %>
          <% if (!orders.length) { %><tr><td colspan="7" class="text-center text-muted py-4">No delivery issue orders found.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </form>
</div>

<%- include('partials/admin-footer') %>
