<%- include('partials/admin-header') %>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 flex-wrap">
    <input type="text" name="q" class="form-control" style="max-width:260px" placeholder="Search order#, name or phone" value="<%= q %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
  </form>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Order ID</th><th>Customer Info</th><th>Amount</th><th>Delivery Man</th><th>Cleared At</th></tr></thead>
      <tbody>
        <% orders.forEach(function (o) { %>
          <tr>
            <td><a href="/admin/orders/<%= o._id %>"><strong>#<%= o.orderNumber %></strong></a></td>
            <td><%= o.customerName %><br><small class="text-muted"><i class="bi bi-telephone"></i> <%= o.customerPhone %></small></td>
            <td><%= currency(o.total) %></td>
            <td><%= o.delivery.deliveryMan ? (o.delivery.deliveryMan.fullName || o.delivery.deliveryMan.username) : '—' %></td>
            <td><small class="text-muted"><%= o.delivery.clearedAt ? new Date(o.delivery.clearedAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—' %></small></td>
          </tr>
        <% }); %>
        <% if (!orders.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No cleared deliveries yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
