<%- include('partials/admin-header') %>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 flex-wrap">
    <input type="text" name="q" class="form-control" style="max-width:260px" placeholder="Search order#, name or phone" value="<%= q %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
  </form>
</div>

<div class="admin-card">
  <form method="post" id="cancelledForm">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
      <div class="form-check">
        <input type="checkbox" class="form-check-input js-select-all" id="selectAllCancelled">
        <label class="form-check-label" for="selectAllCancelled">Select All</label>
      </div>
      <select name="employeeId" class="form-select" style="max-width:220px">
        <option value="">-- Select Employee --</option>
        <% employees.forEach(function (e) { %>
          <option value="<%= e._id %>"><%= e.fullName || e.username %></option>
        <% }); %>
      </select>
      <button type="submit" formaction="/admin/delivery/cancelled/assign" class="btn btn-outline-primary btn-sm">Assign</button>
    </div>

    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th></th><th>Order ID</th><th>Customer Info</th><th>Amount</th><th>Return Status</th><th>Delivery Man</th></tr></thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><input type="checkbox" class="form-check-input" name="ids" value="<%= o._id %>"></td>
              <td>
                <a href="/admin/orders/<%= o._id %>"><strong>#<%= o.orderNumber %></strong></a>
                <br><small class="text-muted"><%= new Date(o.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
              </td>
              <td><%= o.customerName %><br><small class="text-muted"><i class="bi bi-telephone"></i> <%= o.customerPhone %></small></td>
              <td><%= currency(o.total) %></td>
              <td><% if (o.delivery.returnStatus) { %><span class="badge bg-<%= returnStatusBadge(o.delivery.returnStatus) %>"><%= returnStatusLabel(o.delivery.returnStatus) %></span><% } else { %>—<% } %></td>
              <td><%= o.delivery.deliveryMan ? (o.delivery.deliveryMan.fullName || o.delivery.deliveryMan.username) : '—' %></td>
            </tr>
          <% }); %>
          <% if (!orders.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No cancelled orders found.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </form>
</div>

<%- include('partials/admin-footer') %>
