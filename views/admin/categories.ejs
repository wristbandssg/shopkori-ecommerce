<%- include('partials/admin-header') %>

<div class="admin-card mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-diagram-3-fill text-brand"></i> All Categories</h4>
    <a href="/admin/categories/new" class="btn btn-brand"><i class="bi bi-plus-circle"></i> New Category</a>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Image</th><th>Name</th><th>Slug</th><th>Parent</th><th>Order</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% categories.forEach(function (c) { %>
          <tr>
            <td><img src="<%= categoryImageUrl(c.image) %>" class="admin-thumb"></td>
            <td><%= c.name %></td>
            <td><code><%= c.slug %></code></td>
            <td>
              <% if (c.parent) { %>
                <% const p = categories.find(function (x) { return String(x._id) === String(c.parent); }); %>
                <span class="badge bg-light text-dark border">Sub of <%= p ? p.name : '—' %></span>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>
            <td><%= c.sortOrder %></td>
            <td><span class="badge bg-<%= c.status ? 'success' : 'secondary' %>"><%= c.status ? 'Active' : 'Hidden' %></span></td>
            <td class="text-nowrap">
              <a href="/admin/categories/<%= c._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <a href="/admin/categories/delete/<%= c._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this category?" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }); %>
        <% if (!categories.length) { %><tr><td colspan="7" class="text-center text-muted">No categories yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
