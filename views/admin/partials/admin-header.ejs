<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= adminPageTitle %> | Admin - <%= settings.site_name %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="/css/admin.css" rel="stylesheet">
</head>
<body>
<div class="admin-wrapper">

  <aside class="admin-sidebar">
    <div class="admin-brand">
      <i class="bi bi-gift-fill"></i> <%= settings.site_name %>
      <span>Admin Panel</span>
    </div>
    <nav class="admin-nav">
      <a href="/admin" class="<%= currentPage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> ড্যাশবোর্ড</a>
      <a href="/admin/products" class="<%= currentPage === 'products' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> প্রোডাক্ট</a>
      <a href="/admin/categories" class="<%= currentPage === 'categories' ? 'active' : '' %>"><i class="bi bi-tags"></i> ক্যাটাগরি</a>
      <a href="/admin/orders" class="<%= currentPage === 'orders' ? 'active' : '' %>"><i class="bi bi-bag-check"></i> অর্ডার</a>
      <a href="/admin/customers" class="<%= currentPage === 'customers' ? 'active' : '' %>"><i class="bi bi-people"></i> কাস্টমার</a>
      <a href="/admin/reports" class="<%= currentPage === 'reports' ? 'active' : '' %>"><i class="bi bi-graph-up-arrow"></i> সেলস রিপোর্ট</a>
      <a href="/admin/settings" class="<%= currentPage === 'settings' ? 'active' : '' %>"><i class="bi bi-gear"></i> সেটিংস</a>
      <hr>
      <a href="/" target="_blank"><i class="bi bi-eye"></i> স্টোর দেখুন</a>
      <a href="/admin/logout"><i class="bi bi-box-arrow-right"></i> লগআউট</a>
    </nav>
  </aside>

  <div class="admin-content">
    <header class="admin-topbar">
      <button class="sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
      <h1><%= adminPageTitle %></h1>
      <div class="admin-topbar-user">
        <i class="bi bi-person-circle"></i> <%= currentAdmin ? (currentAdmin.fullName || currentAdmin.username) : 'Admin' %>
      </div>
    </header>

    <main class="admin-main">
      <% (flashes || []).forEach(function (f) { %>
        <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert">
          <%= f.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
