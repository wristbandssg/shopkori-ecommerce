<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= adminPageTitle %> | Admin - <%= settings.site_name %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="/css/admin.css" rel="stylesheet">
<% if (typeof extraHead !== 'undefined' && extraHead) { %><%- extraHead %><% } %>
</head>
<body>
<div class="admin-wrapper">

  <aside class="admin-sidebar">
    <div class="admin-brand">
      <i class="bi bi-gift-fill"></i> <%= settings.site_name %>
      <span>Admin Panel</span>
    </div>
    <nav class="admin-nav">
      <a href="/admin" class="<%= currentPage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>

      <button class="admin-nav-toggle <%= currentPage === 'orders' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navOrders" aria-expanded="<%= currentPage === 'orders' ? 'true' : 'false' %>">
        <i class="bi bi-bag-check"></i> Orders <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'orders' ? 'show' : '' %>" id="navOrders">
        <a href="/admin/orders" class="<%= currentSubPath === '/orders' ? 'active' : '' %>">All Orders <span class="submenu-count"><%= orderCounts.all %></span></a>
        <a href="/admin/orders/incomplete" class="<%= currentSubPath === '/orders/incomplete' ? 'active' : '' %>">Incomplete <span class="submenu-count"><%= orderCounts.incomplete %></span></a>
        <a href="/admin/orders?status=delivered" class="<%= (currentSubPath === '/orders' && currentQueryStatus === 'delivered') ? 'active' : '' %>">Delivered <span class="submenu-count"><%= orderCounts.delivered %></span></a>
        <a href="/admin/orders/returned" class="<%= currentSubPath === '/orders/returned' ? 'active' : '' %>">Returned <span class="submenu-count"><%= orderCounts.returned %></span></a>
        <a href="/admin/orders/delivery-issue" class="<%= currentSubPath === '/orders/delivery-issue' ? 'active' : '' %>">Delivery Issue <span class="submenu-count"><%= orderCounts.deliveryIssue %></span></a>
        <a href="/admin/orders/follow-up" class="<%= currentSubPath === '/orders/follow-up' ? 'active' : '' %>">Follow Up</a>
        <a href="/admin/orders/user-activity" class="<%= currentSubPath === '/orders/user-activity' ? 'active' : '' %>">User Activity</a>
        <a href="/admin/orders/near-by" class="<%= currentSubPath === '/orders/near-by' ? 'active' : '' %>">Near By Orders</a>
        <a href="/admin/orders/blocked" class="<%= currentSubPath === '/orders/blocked' ? 'active' : '' %>">Order Block</a>
        <a href="/admin/orders/deleted" class="<%= currentSubPath === '/orders/deleted' ? 'active' : '' %>">Deleted Orders <span class="submenu-count"><%= orderCounts.deleted %></span></a>
        <a href="/admin/orders/setting" class="<%= currentSubPath === '/orders/setting' ? 'active' : '' %>">Order Setting</a>
        <a href="/admin/orders/missed" class="<%= currentSubPath === '/orders/missed' ? 'active' : '' %>">Missed Orders</a>
        <a href="/admin/orders/after-confirm" class="<%= currentSubPath === '/orders/after-confirm' ? 'active' : '' %>">After Confirm</a>
        <a href="/admin/orders/store-analytics" class="<%= currentSubPath === '/orders/store-analytics' ? 'active' : '' %>">Store Analytics</a>
      </div>

      <button class="admin-nav-toggle <%= ['products', 'categories', 'inventory'].includes(currentPage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navProduct" aria-expanded="<%= ['products', 'categories', 'inventory'].includes(currentPage) ? 'true' : 'false' %>">
        <i class="bi bi-box-seam"></i> Products <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= ['products', 'categories', 'inventory'].includes(currentPage) ? 'show' : '' %>" id="navProduct">
        <a href="/admin/products" class="<%= currentSubPath === '/products' ? 'active' : '' %>">Products</a>
        <a href="/admin/categories" class="<%= currentSubPath === '/categories' ? 'active' : '' %>">Category</a>
        <a href="/admin/products/variant" class="<%= currentSubPath === '/products/variant' ? 'active' : '' %>">Variant</a>
        <a href="/admin/products/brands" class="<%= currentSubPath === '/products/brands' ? 'active' : '' %>">Brands</a>
        <a href="/admin/products/supplier" class="<%= currentSubPath === '/products/supplier' ? 'active' : '' %>">Supplier</a>
        <a href="/admin/inventory/purchase" class="<%= currentSubPath === '/inventory/purchase' ? 'active' : '' %>">Purchase</a>
        <a href="/admin/inventory" class="<%= currentSubPath === '/inventory' ? 'active' : '' %>">Inventory</a>
      </div>

      <button class="admin-nav-toggle <%= currentPage === 'delivery' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navDelivery" aria-expanded="<%= currentPage === 'delivery' ? 'true' : 'false' %>">
        <i class="bi bi-truck"></i> Manage Delivery <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'delivery' ? 'show' : '' %>" id="navDelivery">
        <a href="/admin/delivery/delivery-man" class="<%= currentSubPath === '/delivery/delivery-man' ? 'active' : '' %>">Delivery Man</a>
        <a href="/admin/delivery/delivered" class="<%= currentSubPath === '/delivery/delivered' ? 'active' : '' %>">Delivered Order</a>
        <a href="/admin/delivery/clear" class="<%= currentSubPath === '/delivery/clear' ? 'active' : '' %>">Clear Delivery</a>
        <a href="/admin/delivery/cancelled" class="<%= currentSubPath === '/delivery/cancelled' ? 'active' : '' %>">Cancelled Order</a>
        <a href="/admin/delivery/return-confirm" class="<%= currentSubPath === '/delivery/return-confirm' ? 'active' : '' %>">Return Confirm</a>
        <a href="/admin/delivery/amount-request" class="<%= currentSubPath === '/delivery/amount-request' ? 'active' : '' %>">Amount Request</a>
        <a href="/admin/delivery/commission" class="<%= currentSubPath === '/delivery/commission' ? 'active' : '' %>">Delivery Commission</a>
        <a href="/admin/delivery/commission-request" class="<%= currentSubPath === '/delivery/commission-request' ? 'active' : '' %>">Commission Request</a>
      </div>

      <button class="admin-nav-toggle <%= ['marketing', 'analytics', 'reports', 'referral-program', 'offer'].includes(currentPage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navMarketing" aria-expanded="<%= ['marketing', 'analytics', 'reports', 'referral-program', 'offer'].includes(currentPage) ? 'true' : 'false' %>">
        <i class="bi bi-megaphone"></i> Marketing & Offers <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= ['marketing', 'analytics', 'reports', 'referral-program', 'offer'].includes(currentPage) ? 'show' : '' %>" id="navMarketing">
        <a href="/admin/marketing" class="<%= currentPage === 'marketing' ? 'active' : '' %>">Marketing</a>
        <a href="/admin/analytics" class="<%= currentPage === 'analytics' ? 'active' : '' %>">Analytics</a>
        <a href="/admin/reports" class="<%= currentPage === 'reports' ? 'active' : '' %>">Sales Report</a>
        <a href="/admin/referral-program" class="<%= currentPage === 'referral-program' ? 'active' : '' %>">Referral Program</a>
        <a href="/admin/offer/flash-sale" class="<%= currentSubPath === '/offer/flash-sale' ? 'active' : '' %>">Flash Sale</a>
        <a href="/admin/offer/combo" class="<%= currentSubPath === '/offer/combo' ? 'active' : '' %>">Combo Offer</a>
        <a href="/admin/offer/best-sale" class="<%= currentSubPath === '/offer/best-sale' ? 'active' : '' %>">Best Sale Products</a>
        <a href="/admin/offer/popular" class="<%= currentSubPath === '/offer/popular' ? 'active' : '' %>">Popular Products</a>
        <a href="/admin/offer/hot-deal" class="<%= currentSubPath === '/offer/hot-deal' ? 'active' : '' %>">Hot Deal</a>
        <a href="/admin/offer/special" class="<%= currentSubPath === '/offer/special' ? 'active' : '' %>">Special Offer</a>
        <a href="/admin/offer/latest" class="<%= currentSubPath === '/offer/latest' ? 'active' : '' %>">Latest Products</a>
        <a href="/admin/offer/popup" class="<%= currentSubPath === '/offer/popup' ? 'active' : '' %>">PopUp Offer</a>
      </div>

      <button class="admin-nav-toggle <%= ['blog', 'pages', 'landing-page'].includes(currentPage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navContent" aria-expanded="<%= ['blog', 'pages', 'landing-page'].includes(currentPage) ? 'true' : 'false' %>">
        <i class="bi bi-file-earmark-richtext"></i> Content <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= ['blog', 'pages', 'landing-page'].includes(currentPage) ? 'show' : '' %>" id="navContent">
        <a href="/admin/blog" class="<%= currentPage === 'blog' && currentSubPath !== '/blog/categories' ? 'active' : '' %>">Blog</a>
        <a href="/admin/blog/categories" class="<%= currentSubPath === '/blog/categories' ? 'active' : '' %>">Blog Categories</a>
        <a href="/admin/pages" class="<%= currentPage === 'pages' ? 'active' : '' %>">Pages</a>
        <a href="/admin/landing-page/main" class="<%= currentSubPath === '/landing-page/main' ? 'active' : '' %>">Main Landing</a>
        <a href="/admin/landing-page/short" class="<%= currentSubPath === '/landing-page/short' ? 'active' : '' %>">Short Landing</a>
        <a href="/admin/landing-page/checkout" class="<%= currentSubPath === '/landing-page/checkout' ? 'active' : '' %>">Landing Checkout</a>
        <a href="/admin/landing-page/advance" class="<%= currentSubPath === '/landing-page/advance' ? 'active' : '' %>">Advance Landing</a>
      </div>

      <button class="admin-nav-toggle <%= ['settings', 'customization'].includes(currentPage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navSettings" aria-expanded="<%= ['settings', 'customization'].includes(currentPage) ? 'true' : 'false' %>">
        <i class="bi bi-gear"></i> Settings <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= ['settings', 'customization'].includes(currentPage) ? 'show' : '' %>" id="navSettings">
        <a href="/admin/settings" class="<%= currentPage === 'settings' ? 'active' : '' %>">Setting</a>
        <a href="/admin/customization" class="<%= currentPage === 'customization' ? 'active' : '' %>">Customization</a>
      </div>

      <button class="admin-nav-toggle <%= ['staff', 'task-management'].includes(currentPage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navStaffTeam" aria-expanded="<%= ['staff', 'task-management'].includes(currentPage) ? 'true' : 'false' %>">
        <i class="bi bi-people"></i> Staff & Team <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= ['staff', 'task-management'].includes(currentPage) ? 'show' : '' %>" id="navStaffTeam">
        <a href="/admin/staff" class="<%= currentPage === 'staff' ? 'active' : '' %>">Staff Setup</a>
        <a href="/admin/task-management" class="<%= currentPage === 'task-management' ? 'active' : '' %>">Task Management</a>
      </div>

      <a href="/admin/customers" class="<%= currentPage === 'customers' ? 'active' : '' %>"><i class="bi bi-person-lines-fill"></i> Customers</a>

      <a href="/admin/vendors" class="<%= currentPage === 'vendors' ? 'active' : '' %>"><i class="bi bi-shop"></i> Vendors</a>

      <button class="admin-nav-toggle <%= ['announcements', 'security', 'integrations', 'help-support'].includes(currentPage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navAdminTools" aria-expanded="<%= ['announcements', 'security', 'integrations', 'help-support'].includes(currentPage) ? 'true' : 'false' %>">
        <i class="bi bi-tools"></i> Admin Tools <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= ['announcements', 'security', 'integrations', 'help-support'].includes(currentPage) ? 'show' : '' %>" id="navAdminTools">
        <a href="/admin/announcements" class="<%= currentPage === 'announcements' ? 'active' : '' %>">Announcements</a>
        <a href="/admin/security" class="<%= currentPage === 'security' ? 'active' : '' %>">Security Dashboard</a>
        <a href="/admin/integrations" class="<%= currentPage === 'integrations' ? 'active' : '' %>">API & Integrations</a>
        <a href="/admin/help-support" class="<%= currentPage === 'help-support' ? 'active' : '' %>">Help & Support</a>
      </div>

      <hr>
      <a href="/" target="_blank"><i class="bi bi-eye"></i> View Store</a>
      <a href="/admin/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </nav>
  </aside>

  <div class="admin-content">
    <header class="admin-topbar">
      <button class="sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
      <h1><%= adminPageTitle %></h1>
      <div class="admin-topbar-user">
        <i class="bi bi-person-circle"></i> <%= currentAdmin ? (currentAdmin.fullName || currentAdmin.username) : 'Admin' %>
      </div>
    </header>

    <main class="admin-main">
      <% (flashes || []).forEach(function (f) { %>
        <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert">
          <%= f.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>

      <!-- Admin > Announcement System (audience: Admin Staff). Dismissed
           per-browser via localStorage so it doesn't reappear on every
           page nav once closed, but comes back for anyone who hasn't seen
           it yet (see the inline script at the bottom of this partial). -->
      <% (adminAnnouncements || []).forEach(function (a) { %>
        <div class="alert alert-warning alert-dismissible fade show admin-announcement" data-announcement-id="<%= a._id %>" role="alert">
          <strong><i class="bi bi-megaphone-fill"></i> <%= a.title %>:</strong> <%= a.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" onclick="try { var seen = JSON.parse(localStorage.getItem('shopkori_dismissed_announcements') || '[]'); seen.push('<%= a._id %>'); localStorage.setItem('shopkori_dismissed_announcements', JSON.stringify(seen)); } catch (e) {}"></button>
        </div>
      <% }); %>
