<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= adminPageTitle %> | Admin - <%= settings.site_name %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="/css/admin.css" rel="stylesheet">
</head>
<body>
<div class="admin-wrapper">

  <aside class="admin-sidebar">
    <div class="admin-brand">
      <i class="bi bi-gift-fill"></i> <%= settings.site_name %>
      <span>Admin Panel</span>
    </div>
    <nav class="admin-nav">
      <a href="/admin" class="<%= currentPage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> ড্যাশবোর্ড</a>

      <button class="admin-nav-toggle <%= currentPage === 'orders' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navOrders" aria-expanded="<%= currentPage === 'orders' ? 'true' : 'false' %>">
        <i class="bi bi-bag-check"></i> অর্ডার <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'orders' ? 'show' : '' %>" id="navOrders">
        <a href="/admin/orders" class="<%= currentSubPath === '/orders' ? 'active' : '' %>">All Orders</a>
        <a href="/admin/orders/incomplete" class="<%= currentSubPath === '/orders/incomplete' ? 'active' : '' %>">Incomplete</a>
        <a href="/admin/orders?status=delivered" class="<%= (currentSubPath === '/orders' && currentQueryStatus === 'delivered') ? 'active' : '' %>">Delivered</a>
        <a href="/admin/orders/returned" class="<%= currentSubPath === '/orders/returned' ? 'active' : '' %>">Returned</a>
        <a href="/admin/orders/delivery-issue" class="<%= currentSubPath === '/orders/delivery-issue' ? 'active' : '' %>">Delivery Issue</a>
        <a href="/admin/orders/follow-up" class="<%= currentSubPath === '/orders/follow-up' ? 'active' : '' %>">Follow Up</a>
        <a href="/admin/orders/user-activity" class="<%= currentSubPath === '/orders/user-activity' ? 'active' : '' %>">User Activity</a>
        <a href="/admin/orders/near-by" class="<%= currentSubPath === '/orders/near-by' ? 'active' : '' %>">Near By Orders</a>
        <a href="/admin/orders/blocked" class="<%= currentSubPath === '/orders/blocked' ? 'active' : '' %>">Order Block</a>
        <a href="/admin/orders/deleted" class="<%= currentSubPath === '/orders/deleted' ? 'active' : '' %>">Deleted Orders</a>
        <a href="/admin/orders/setting" class="<%= currentSubPath === '/orders/setting' ? 'active' : '' %>">Order Setting</a>
        <a href="/admin/orders/missed" class="<%= currentSubPath === '/orders/missed' ? 'active' : '' %>">Missed Orders</a>
        <a href="/admin/orders/after-confirm" class="<%= currentSubPath === '/orders/after-confirm' ? 'active' : '' %>">After Confirm</a>
        <a href="/admin/orders/store-analytics" class="<%= currentSubPath === '/orders/store-analytics' ? 'active' : '' %>">Store Analytics</a>
      </div>

      <button class="admin-nav-toggle <%= currentPage === 'products' || currentPage === 'categories' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navProduct" aria-expanded="<%= currentPage === 'products' || currentPage === 'categories' ? 'true' : 'false' %>">
        <i class="bi bi-box-seam"></i> Manage Product <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'products' || currentPage === 'categories' ? 'show' : '' %>" id="navProduct">
        <a href="/admin/products" class="<%= currentSubPath === '/products' ? 'active' : '' %>">Products</a>
        <a href="/admin/categories" class="<%= currentSubPath === '/categories' ? 'active' : '' %>">Category</a>
        <a href="/admin/products/variant" class="<%= currentSubPath === '/products/variant' ? 'active' : '' %>">Variant</a>
        <a href="/admin/products/brands" class="<%= currentSubPath === '/products/brands' ? 'active' : '' %>">Brands</a>
        <a href="/admin/products/supplier" class="<%= currentSubPath === '/products/supplier' ? 'active' : '' %>">Supplier</a>
      </div>

      <button class="admin-nav-toggle <%= currentPage === 'delivery' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navDelivery" aria-expanded="<%= currentPage === 'delivery' ? 'true' : 'false' %>">
        <i class="bi bi-truck"></i> Manage Delivery <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'delivery' ? 'show' : '' %>" id="navDelivery">
        <a href="/admin/delivery/delivery-man" class="<%= currentSubPath === '/delivery/delivery-man' ? 'active' : '' %>">Delivery Man</a>
        <a href="/admin/delivery/delivered" class="<%= currentSubPath === '/delivery/delivered' ? 'active' : '' %>">Delivered Order</a>
        <a href="/admin/delivery/clear" class="<%= currentSubPath === '/delivery/clear' ? 'active' : '' %>">Clear Delivery</a>
        <a href="/admin/delivery/cancelled" class="<%= currentSubPath === '/delivery/cancelled' ? 'active' : '' %>">Cancelled Order</a>
        <a href="/admin/delivery/return-confirm" class="<%= currentSubPath === '/delivery/return-confirm' ? 'active' : '' %>">Return Confirm</a>
        <a href="/admin/delivery/amount-request" class="<%= currentSubPath === '/delivery/amount-request' ? 'active' : '' %>">Amount Request</a>
        <a href="/admin/delivery/commission" class="<%= currentSubPath === '/delivery/commission' ? 'active' : '' %>">Delivery Commission</a>
        <a href="/admin/delivery/commission-request" class="<%= currentSubPath === '/delivery/commission-request' ? 'active' : '' %>">Commission Request</a>
      </div>

      <a href="/admin/marketing" class="<%= currentPage === 'marketing' ? 'active' : '' %>"><i class="bi bi-megaphone"></i> Marketing</a>
      <a href="/admin/analytics" class="<%= currentPage === 'analytics' ? 'active' : '' %>"><i class="bi bi-graph-up"></i> Analytics</a>

      <button class="admin-nav-toggle <%= currentPage === 'landing-page' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navLanding" aria-expanded="<%= currentPage === 'landing-page' ? 'true' : 'false' %>">
        <i class="bi bi-globe2"></i> Landing Page <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'landing-page' ? 'show' : '' %>" id="navLanding">
        <a href="/admin/landing-page/main" class="<%= currentSubPath === '/landing-page/main' ? 'active' : '' %>">Main Landing</a>
        <a href="/admin/landing-page/short" class="<%= currentSubPath === '/landing-page/short' ? 'active' : '' %>">Short Landing</a>
        <a href="/admin/landing-page/checkout" class="<%= currentSubPath === '/landing-page/checkout' ? 'active' : '' %>">Landing Checkout</a>
        <a href="/admin/landing-page/advance" class="<%= currentSubPath === '/landing-page/advance' ? 'active' : '' %>">Advance Landing</a>
      </div>

      <a href="/admin/blog" class="<%= currentPage === 'blog' ? 'active' : '' %>"><i class="bi bi-journal-richtext"></i> ব্লগ</a>
      <a href="/admin/pages" class="<%= currentPage === 'pages' ? 'active' : '' %>"><i class="bi bi-file-earmark-text"></i> পেজ ম্যানেজমেন্ট</a>

      <a href="/admin/settings" class="<%= currentPage === 'settings' ? 'active' : '' %>"><i class="bi bi-gear"></i> Setting</a>
      <a href="/admin/customization" class="<%= currentPage === 'customization' ? 'active' : '' %>"><i class="bi bi-sliders"></i> Customization</a>

      <button class="admin-nav-toggle <%= currentPage === 'inventory' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navInventory" aria-expanded="<%= currentPage === 'inventory' ? 'true' : 'false' %>">
        <i class="bi bi-building"></i> Inventory <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'inventory' ? 'show' : '' %>" id="navInventory">
        <a href="/admin/inventory/purchase" class="<%= currentSubPath === '/inventory/purchase' ? 'active' : '' %>">Purchase</a>
        <a href="/admin/inventory" class="<%= currentSubPath === '/inventory' ? 'active' : '' %>">Inventory</a>
      </div>

      <button class="admin-nav-toggle <%= currentPage === 'offer' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navOffer" aria-expanded="<%= currentPage === 'offer' ? 'true' : 'false' %>">
        <i class="bi bi-tag"></i> Offer Setting <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'offer' ? 'show' : '' %>" id="navOffer">
        <a href="/admin/offer/flash-sale" class="<%= currentSubPath === '/offer/flash-sale' ? 'active' : '' %>">Flash Sale</a>
        <a href="/admin/offer/combo" class="<%= currentSubPath === '/offer/combo' ? 'active' : '' %>">Combo Offer</a>
        <a href="/admin/offer/best-sale" class="<%= currentSubPath === '/offer/best-sale' ? 'active' : '' %>">Best Sale Products</a>
        <a href="/admin/offer/popular" class="<%= currentSubPath === '/offer/popular' ? 'active' : '' %>">Popular Products</a>
        <a href="/admin/offer/hot-deal" class="<%= currentSubPath === '/offer/hot-deal' ? 'active' : '' %>">Hot Deal</a>
        <a href="/admin/offer/special" class="<%= currentSubPath === '/offer/special' ? 'active' : '' %>">Special Offer</a>
        <a href="/admin/offer/latest" class="<%= currentSubPath === '/offer/latest' ? 'active' : '' %>">Latest Products</a>
        <a href="/admin/offer/popup" class="<%= currentSubPath === '/offer/popup' ? 'active' : '' %>">PopUp Offer</a>
      </div>

      <a href="/admin/staff" class="<%= currentPage === 'staff' ? 'active' : '' %>"><i class="bi bi-people"></i> Staff</a>

      <button class="admin-nav-toggle <%= currentPage === 'accounting' ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#navAccounting" aria-expanded="<%= currentPage === 'accounting' ? 'true' : 'false' %>">
        <i class="bi bi-calculator"></i> Accounting <i class="bi bi-chevron-down chevron"></i>
      </button>
      <div class="collapse admin-submenu <%= currentPage === 'accounting' ? 'show' : '' %>" id="navAccounting">
        <a href="/admin/accounting/income" class="<%= currentSubPath === '/accounting/income' ? 'active' : '' %>">Income</a>
        <a href="/admin/accounting/expenses" class="<%= currentSubPath === '/accounting/expenses' ? 'active' : '' %>">Expenses</a>
        <a href="/admin/accounting/expense-list" class="<%= currentSubPath === '/accounting/expense-list' ? 'active' : '' %>">Expense List</a>
        <a href="/admin/accounting/due-payment" class="<%= currentSubPath === '/accounting/due-payment' ? 'active' : '' %>">Due Payment</a>
        <a href="/admin/accounting/employee-salary" class="<%= currentSubPath === '/accounting/employee-salary' ? 'active' : '' %>">Employee Salary</a>
        <a href="/admin/accounting/bill-statements" class="<%= currentSubPath === '/accounting/bill-statements' ? 'active' : '' %>">Bill Statements</a>
        <a href="/admin/accounting/balance-transfer" class="<%= currentSubPath === '/accounting/balance-transfer' ? 'active' : '' %>">Balance Transfer</a>
        <a href="/admin/accounting/balance-overview" class="<%= currentSubPath === '/accounting/balance-overview' ? 'active' : '' %>">Balance Overview</a>
      </div>

      <a href="/admin/task-management" class="<%= currentPage === 'task-management' ? 'active' : '' %>"><i class="bi bi-list-task"></i> Task Management</a>
      <a href="/admin/pos" class="<%= currentPage === 'pos' ? 'active' : '' %>"><i class="bi bi-shop"></i> POS</a>
      <a href="/admin/customers" class="<%= currentPage === 'customers' ? 'active' : '' %>"><i class="bi bi-person-lines-fill"></i> Customers</a>
      <a href="/admin/referral-program" class="<%= currentPage === 'referral-program' ? 'active' : '' %>"><i class="bi bi-share"></i> Referral Program</a>
      <a href="/admin/our-service" class="<%= currentPage === 'our-service' ? 'active' : '' %>"><i class="bi bi-award"></i> Our Service</a>
      <a href="/admin/help-support" class="<%= currentPage === 'help-support' ? 'active' : '' %>"><i class="bi bi-question-circle"></i> Help & Support</a>
      <a href="/admin/reports" class="<%= currentPage === 'reports' ? 'active' : '' %>"><i class="bi bi-graph-up-arrow"></i> সেলস রিপোর্ট</a>

      <hr>
      <a href="/" target="_blank"><i class="bi bi-eye"></i> স্টোর দেখুন</a>
      <a href="/admin/logout"><i class="bi bi-box-arrow-right"></i> লগআউট</a>
    </nav>
  </aside>

  <div class="admin-content">
    <header class="admin-topbar">
      <button class="sidebar-toggle d-lg-none"><i class="bi bi-list"></i></button>
      <h1><%= adminPageTitle %></h1>
      <div class="admin-topbar-user">
        <i class="bi bi-person-circle"></i> <%= currentAdmin ? (currentAdmin.fullName || currentAdmin.username) : 'Admin' %>
      </div>
    </header>

    <main class="admin-main">
      <% (flashes || []).forEach(function (f) { %>
        <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert">
          <%= f.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
