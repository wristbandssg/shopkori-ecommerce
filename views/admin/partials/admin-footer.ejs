<script>
  // Admin > Announcement System — hide any banner this browser already
  // dismissed (see the dismiss button's onclick above).
  try {
    var dismissed = JSON.parse(localStorage.getItem('shopkori_dismissed_announcements') || '[]');
    document.querySelectorAll('.admin-announcement').forEach(function (el) {
      if (dismissed.indexOf(el.getAttribute('data-announcement-id')) !== -1) el.remove();
    });
  } catch (e) {}
</script>
