<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/customization" class="text-decoration-none">Customize Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Order Page Setting</span>
</nav>

<h5 class="mb-3">Order Page Setting</h5>

<% if (!showForm) { %>
  <div class="admin-card text-center py-5">
    <i class="bi bi-cart-check display-4 text-muted"></i>
    <h6 class="mt-3">No Order Page Found</h6>
    <p class="text-muted small">Create your first order page to manage your store orders effectively.</p>
    <a href="/admin/customization/order-page?new=1" class="btn btn-brand mt-2"><i class="bi bi-plus-lg"></i> Create Order Page</a>
  </div>
<% } else { %>
  <div class="admin-card" style="max-width:700px">
    <h5 class="mb-3">Create Order Page</h5>
    <form method="post" action="/admin/customization/order-page">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <div class="row g-3 mb-3">
        <div class="col-md-6"><label class="form-label">Buy More</label><input type="text" name="buyMore" class="form-control" value="<%= orderPage ? orderPage.buyMore : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Order Now</label><input type="text" name="orderNow" class="form-control" value="<%= orderPage ? orderPage.orderNow : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Call Center</label><input type="text" name="callCenter" class="form-control" value="<%= orderPage ? orderPage.callCenter : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Call Center Number</label><input type="text" name="callCenterNumber" class="form-control" value="<%= orderPage ? orderPage.callCenterNumber : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Support</label><input type="text" name="support" class="form-control" value="<%= orderPage ? orderPage.support : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Support Number</label><input type="text" name="supportNumber" class="form-control" value="<%= orderPage ? orderPage.supportNumber : '' %>"></div>
        <div class="col-md-6"><label class="form-label">WhatsApp</label><input type="text" name="whatsapp" class="form-control" value="<%= orderPage ? orderPage.whatsapp : '' %>"></div>
        <div class="col-md-6"><label class="form-label">WhatsApp Number</label><input type="text" name="whatsappNumber" class="form-control" value="<%= orderPage ? orderPage.whatsappNumber : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Messenger</label><input type="text" name="messenger" class="form-control" value="<%= orderPage ? orderPage.messenger : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Messenger Link</label><input type="text" name="messengerLink" class="form-control" value="<%= orderPage ? orderPage.messengerLink : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Delivery</label><input type="text" name="delivery" class="form-control" value="<%= orderPage ? orderPage.delivery : '' %>"></div>
        <div class="col-md-6">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="On" <%= !orderPage || orderPage.status ? 'selected' : '' %>>On</option>
            <option value="Off" <%= orderPage && !orderPage.status ? 'selected' : '' %>>Off</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-brand">Save</button>
      <a href="/admin/customization" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
<% } %>

<%- include('partials/admin-footer') %>
