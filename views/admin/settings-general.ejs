<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/settings" class="text-decoration-none">Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">General Settings</span>
</nav>

<div class="admin-card" style="max-width:700px">
  <form method="post" action="/admin/settings/general">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <div class="mb-3"><label class="form-label">Site Name</label><input type="text" name="site_name" class="form-control" value="<%= settingsData.site_name %>"></div>
    <div class="mb-3"><label class="form-label">Tagline</label><input type="text" name="site_tagline" class="form-control" value="<%= settingsData.site_tagline %>"></div>
    <div class="mb-3"><label class="form-label">Currency Symbol</label><input type="text" name="currency_symbol" class="form-control" value="<%= settingsData.currency_symbol %>"></div>
    <div class="mb-3"><label class="form-label">Flat Delivery Charge (৳)</label><input type="number" step="0.01" name="flat_shipping_fee" class="form-control" value="<%= settingsData.flat_shipping_fee %>"></div>
    <div class="mb-3"><label class="form-label">bKash Number</label><input type="text" name="bkash_number" class="form-control" value="<%= settingsData.bkash_number %>"></div>
    <div class="mb-3"><label class="form-label">Phone Number</label><input type="text" name="phone" class="form-control" value="<%= settingsData.phone %>"></div>
    <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" value="<%= settingsData.email %>"></div>
    <div class="mb-3"><label class="form-label">Address</label><textarea name="address" class="form-control"><%= settingsData.address %></textarea></div>
    <p class="text-muted small">Note: to change the SSLCommerz store ID/password or database connection, edit the <code>.env</code> file in the project root (then restart the server) — or set live SSLCommerz credentials under Settings &gt; Payment Methods &gt; SSL Commerz Payment, which takes priority over <code>.env</code> once turned on.</p>
    <button type="submit" class="btn btn-brand">Save</button>
  </form>
</div>

<%- include('partials/admin-footer') %>
