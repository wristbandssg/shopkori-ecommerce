<%- include('partials/admin-header') %>

<h5 class="mb-3">All Custom Landing</h5>

<div class="admin-card mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-list-check text-brand"></i> Landing List</h4>
    <a href="/admin/landing-page/checkout/new" class="btn btn-brand"><i class="bi bi-plus-circle"></i> Add New</a>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Title</th><th>Slug</th><th>Action</th></tr></thead>
      <tbody>
        <% landingCheckouts.forEach(function (p) { %>
          <tr>
            <td>
              <%= p.title %>
              <span class="badge bg-<%= p.status ? 'success' : 'secondary' %> ms-1"><%= p.status ? 'Active' : 'Hidden' %></span>
            </td>
            <td><code><%= p.slug %></code></td>
            <td class="text-nowrap">
              <a href="/admin/landing-page/checkout/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <a href="/admin/landing-page/checkout/delete/<%= p._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this landing checkout page?" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }); %>
        <% if (!landingCheckouts.length) { %><tr><td colspan="3" class="text-center text-muted">No landing checkout pages yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
