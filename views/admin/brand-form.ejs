<%
  const d = brand || {};
  const isEdit = !!(brand && brand._id);
  const formAction = isEdit ? `/admin/products/brands/${brand._id}/edit` : '/admin/products/brands/new';
  const hasAdvancedData = !!(d.metaTitle || d.metaKeywords || d.metaDescription);
  const advDisplay = hasAdvancedData ? '' : 'none';
%>
<%- include('partials/admin-header') %>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (err) { %><li><%= err %></li><% }); %></ul></div>
<% } %>

<form method="post" action="<%= formAction %>" enctype="multipart/form-data" id="brandForm">
  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-award-fill text-brand"></i> <%= isEdit ? 'Edit Brand' : 'Add New Brand' %></h4>
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" id="toggleAdvanced" <%= hasAdvancedData ? 'checked' : '' %>>
        <label class="form-check-label" for="toggleAdvanced">Show Advanced Options</label>
      </div>
      <a href="/admin/products/brands" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> Save</button>
    </div>
  </div>

  <div class="row g-3">
    <!-- =====================================================
         MAIN COLUMN — the brand's page content
         ===================================================== -->
    <div class="col-lg-8">

      <!-- ---------- Basic Information ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-card-text"></i> Basic Information</h5>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Brand Name *</label>
            <input type="text" name="name" class="form-control" required value="<%= d.name || '' %>">
            <div class="form-text">Shown on every product from this brand, and used in the brand page URL.</div>
          </div>
        </div>
      </div>

      <!-- ---------- Brand Page Content (SEO) ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-file-earmark-richtext"></i> Brand Page Content</h5>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Page Title <small class="text-muted">(big heading shown on the brand page — leave blank to just use the name above)</small></label>
            <input type="text" name="pageTitle" class="form-control" placeholder="e.g. Buy Genuine Products Online BD | <%= settings.site_name %>" value="<%= d.pageTitle || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Short Intro <small class="text-muted">(~150 words, shown right under the brand name, above the products)</small></label>
            <textarea name="shortDescription" class="form-control" rows="3" placeholder="e.g. Shop the full lineup — 100% genuine products with fast delivery all over Bangladesh."><%= d.shortDescription || '' %></textarea>
          </div>

          <div class="col-12">
            <label class="form-label mb-1">Google Search Preview <small class="text-muted">(updates as you type)</small></label>
            <div class="serp-preview" id="serpPreview">
              <div class="serp-preview-url"><span id="serpUrl"><%= settings.site_name %> › brand › <%= d.slug || 'your-brand' %></span></div>
              <div class="serp-preview-title" id="serpTitle"></div>
              <div class="serp-preview-desc" id="serpDesc"></div>
            </div>
          </div>

          <div class="col-12">
            <label class="form-label">Content Below Products <small class="text-muted">(longer SEO write-up, shown after the product grid)</small></label>
            <div class="custom-editor" id="descEditorWrap">
              <div class="custom-editor-toolbar" id="descToolbar">
                <button type="button" data-cmd="bold" title="Bold"><i class="bi bi-type-bold"></i></button>
                <button type="button" data-cmd="italic" title="Italic"><i class="bi bi-type-italic"></i></button>
                <button type="button" data-cmd="underline" title="Underline"><i class="bi bi-type-underline"></i></button>
                <button type="button" data-cmd="strikeThrough" title="Strikethrough"><i class="bi bi-type-strikethrough"></i></button>
                <span class="custom-editor-sep"></span>
                <button type="button" data-cmd="formatBlock" data-value="H2" title="Heading"><i class="bi bi-type-h2"></i></button>
                <button type="button" data-cmd="formatBlock" data-value="H3" title="Subheading"><i class="bi bi-type-h3"></i></button>
                <button type="button" data-cmd="formatBlock" data-value="P" title="Paragraph">¶</button>
                <span class="custom-editor-sep"></span>
                <button type="button" data-cmd="insertUnorderedList" title="Bullet list"><i class="bi bi-list-ul"></i></button>
                <button type="button" data-cmd="insertOrderedList" title="Numbered list"><i class="bi bi-list-ol"></i></button>
                <button type="button" data-cmd="formatBlock" data-value="BLOCKQUOTE" title="Quote"><i class="bi bi-quote"></i></button>
                <span class="custom-editor-sep"></span>
                <button type="button" id="descLinkBtn" title="Insert link"><i class="bi bi-link-45deg"></i></button>
                <button type="button" data-cmd="unlink" title="Remove link"><i class="bi bi-link"></i></button>
                <span class="custom-editor-sep"></span>
                <button type="button" data-cmd="removeFormat" title="Clear formatting"><i class="bi bi-eraser"></i></button>
              </div>
              <div class="custom-editor-body" id="descEditor" contenteditable="true"><%- d.description || '' %></div>
            </div>
            <textarea name="description" id="description" style="display:none"><%= d.description || '' %></textarea>
          </div>
        </div>
      </div>

      <!-- ---------- SEO (advanced) ---------- -->
      <div class="admin-card mb-3 advanced-block" style="display:<%= advDisplay %>">
        <h5><i class="bi bi-search"></i> SEO</h5>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Meta Title</label>
            <input type="text" name="metaTitle" class="form-control" value="<%= d.metaTitle || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Meta Keywords</label>
            <input type="text" name="metaKeywords" class="form-control" value="<%= d.metaKeywords || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Meta Description</label>
            <input type="text" name="metaDescription" class="form-control" value="<%= d.metaDescription || '' %>">
          </div>
        </div>
      </div>

    </div>

    <!-- =====================================================
         SIDEBAR — status, organization, logo, banner
         ===================================================== -->
    <div class="col-lg-4">

      <!-- ---------- Status ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-toggle2-on"></i> Status</h5>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="status" id="brandStatus" <%= (d.status === undefined || d.status) ? 'checked' : '' %>>
          <label class="form-check-label" for="brandStatus">Active (Show in Store)</label>
        </div>
      </div>

      <!-- ---------- Organization ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-sort-numeric-down"></i> Organization</h5>
        <label class="form-label">Sort Order</label>
        <input type="number" name="sortOrder" class="form-control" value="<%= d.sortOrder !== undefined ? d.sortOrder : 0 %>">
      </div>

      <!-- ---------- Logo ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-images"></i> Logo</h5>
        <label class="form-label">Shown next to the brand name and on product filters</label>
        <input type="file" name="image" class="form-control" accept="image/*">
        <% if (d.image) { %><img src="<%= categoryImageUrl(d.image) %>" class="admin-thumb mt-2"><% } %>
      </div>

      <!-- ---------- Banner ---------- -->
      <div class="admin-card mb-3">
        <h5><i class="bi bi-image"></i> Banner</h5>
        <label class="form-label">Wide banner shown at the top of the brand page (optional)</label>
        <input type="file" name="bannerImage" class="form-control" accept="image/*">
        <% if (d.bannerImage) { %><img src="<%= categoryImageUrl(d.bannerImage) %>" class="admin-thumb mt-2" style="width:100%;height:80px;object-fit:cover"><% } %>
      </div>

    </div>
  </div>

  <div class="mb-4">
    <button type="submit" class="btn btn-brand"><i class="bi bi-check2"></i> Save</button>
    <a href="/admin/products/brands" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // ---- Live Google search-result preview ----
  (function () {
    var nameInput = document.querySelector('input[name="name"]');
    var pageTitleInput = document.querySelector('input[name="pageTitle"]');
    var shortDescInput = document.querySelector('textarea[name="shortDescription"]');
    var metaTitleInput = document.querySelector('input[name="metaTitle"]');
    var metaDescInput = document.querySelector('input[name="metaDescription"]');
    var siteName = <%- JSON.stringify(settings.site_name) %>;
    var titleEl = document.getElementById('serpTitle');
    var descEl = document.getElementById('serpDesc');
    var urlEl = document.getElementById('serpUrl');

    function slugPreview(text) {
      return (text || 'your-brand')
        .toLowerCase().trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-') || 'your-brand';
    }

    function updatePreview() {
      var title = metaTitleInput.value.trim() || pageTitleInput.value.trim() || nameInput.value.trim() || 'Brand Title';
      var desc = metaDescInput.value.trim() || shortDescInput.value.trim() || 'Add a Short Intro or Meta Description so this shows up nicely in Google.';
      titleEl.textContent = title + ' | ' + siteName;
      descEl.textContent = desc.length > 160 ? desc.slice(0, 157) + '…' : desc;
      urlEl.textContent = siteName + ' › brand › ' + slugPreview(pageTitleInput.value || nameInput.value);
    }

    [nameInput, pageTitleInput, shortDescInput, metaTitleInput, metaDescInput].forEach(function (el) {
      el.addEventListener('input', updatePreview);
    });
    updatePreview();
  })();

  // ---- Show Advanced Options toggle ----
  (function () {
    var advToggle = document.getElementById('toggleAdvanced');
    var advBlocks = document.querySelectorAll('.advanced-block');
    advToggle.addEventListener('change', function () {
      advBlocks.forEach(function (el) {
        el.style.display = advToggle.checked ? '' : 'none';
      });
    });
  })();

  // ---- Custom rich text editor for "Content Below Products" ----
  (function () {
    var toolbar = document.getElementById('descToolbar');
    var editor = document.getElementById('descEditor');
    var hiddenDesc = document.getElementById('description');
    var linkBtn = document.getElementById('descLinkBtn');

    function exec(cmd, value) {
      editor.focus();
      var v = (cmd === 'formatBlock' && value) ? '<' + value + '>' : (value || null);
      document.execCommand(cmd, false, v);
    }

    toolbar.querySelectorAll('button[data-cmd]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        exec(btn.getAttribute('data-cmd'), btn.getAttribute('data-value'));
      });
    });

    linkBtn.addEventListener('click', function () {
      var url = window.prompt('লিংকের URL দিন (উদাহরণ: https://example.com):');
      if (url) exec('createLink', url);
    });

    document.getElementById('brandForm').addEventListener('submit', function () {
      hiddenDesc.value = editor.innerHTML;
    });
  })();
});
</script>

<%- include('partials/admin-footer') %>
