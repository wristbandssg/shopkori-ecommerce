<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/analytics" class="text-decoration-none">Analytics Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted"><%= meta.title %></span>
</nav>

<div class="row g-3 mb-3">
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#337ab7;"><i class="bi bi-box-seam"></i></div>
      <div><span class="stat-value"><%= totalProducts %></span><span class="stat-label">Total Products</span></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#2e9e5b;"><i class="bi bi-stack"></i></div>
      <div><span class="stat-value"><%= totalStockUnits %></span><span class="stat-label">Total Stock Units</span></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#f0ad4e;"><i class="bi bi-cash-stack"></i></div>
      <div><span class="stat-value"><%= currency(totalStockValue) %></span><span class="stat-label">Total Stock Value</span></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card">
      <div class="stat-icon" style="background:#d9534f;"><i class="bi bi-exclamation-circle"></i></div>
      <div><span class="stat-value"><%= outOfStockCount %></span><span class="stat-label">Out of Stock</span></div>
    </div>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Created</th></tr></thead>
      <tbody>
        <% products.forEach(function (p) { %>
          <tr>
            <td class="d-flex align-items-center gap-2"><img src="<%= productImageUrl(p.image) %>" class="admin-thumb"><%= p.name %></td>
            <td><%= p.category ? p.category.name : '—' %></td>
            <td><%= currency(p.price) %></td>
            <td><%= p.stock %></td>
            <td><span class="badge bg-<%= p.status ? 'success' : 'secondary' %>"><%= p.status ? 'Active' : 'Hidden' %></span></td>
            <td><small class="text-muted"><%= new Date(p.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></small></td>
          </tr>
        <% }); %>
        <% if (!products.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No products yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
