<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/customization" class="text-decoration-none">Customize Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Home Setting</span>
</nav>

<h5 class="mb-3">Home Setting</h5>

<% if (!showForm) { %>
  <div class="admin-card text-center py-5">
    <i class="bi bi-house-gear display-4 text-muted"></i>
    <h6 class="mt-3">No settings found</h6>
    <a href="/admin/customization/home-setting?new=1" class="btn btn-brand mt-2"><i class="bi bi-plus-lg"></i> Add New Setting</a>
  </div>
<% } else { %>
  <div class="admin-card" style="max-width:700px">
    <h5 class="mb-3">Create Home Settings</h5>
    <form method="post" action="/admin/customization/home-setting" enctype="multipart/form-data">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <div class="row g-3 mb-3">
        <div class="col-md-6"><label class="form-label">Header</label><input type="text" name="header" class="form-control" value="<%= homeSetting ? homeSetting.header : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Phone Number</label><input type="text" name="phone" class="form-control" value="<%= homeSetting ? homeSetting.phone : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Email</label><input type="email" name="email" class="form-control" value="<%= homeSetting ? homeSetting.email : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Address</label><input type="text" name="address" class="form-control" value="<%= homeSetting ? homeSetting.address : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Twitter</label><input type="text" name="twitter" class="form-control" value="<%= homeSetting ? homeSetting.twitter : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Facebook</label><input type="text" name="facebook" class="form-control" value="<%= homeSetting ? homeSetting.facebook : '' %>"></div>
        <div class="col-md-6"><label class="form-label">YouTube</label><input type="text" name="youtube" class="form-control" value="<%= homeSetting ? homeSetting.youtube : '' %>"></div>
        <div class="col-md-6"><label class="form-label">WhatsApp</label><input type="text" name="whatsapp" class="form-control" value="<%= homeSetting ? homeSetting.whatsapp : '' %>"></div>
        <div class="col-md-6"><label class="form-label">Messenger</label><input type="text" name="messenger" class="form-control" value="<%= homeSetting ? homeSetting.messenger : '' %>"></div>
        <div class="col-md-6">
          <label class="form-label">Logo</label>
          <% if (homeSetting && storeAssetUrl(homeSetting.logo)) { %><img src="<%= storeAssetUrl(homeSetting.logo) %>" class="admin-thumb d-block mb-2" style="max-height:50px"><% } %>
          <input type="file" name="logo" class="form-control" accept="image/*">
        </div>
      </div>
      <button type="submit" class="btn btn-brand">Save</button>
      <a href="/admin/customization" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
<% } %>

<%- include('partials/admin-footer') %>
