<%- include('partials/admin-header') %>

<div class="admin-card mb-3">
  <form method="get" class="d-flex gap-2 flex-wrap">
    <input type="text" name="q" class="form-control" style="max-width:260px" placeholder="Search by order# or phone" value="<%= q %>">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
  </form>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Order ID</th><th>Customer Info</th><th>Amount</th><th>Status</th><th>Deleted At</th><th>Action</th></tr></thead>
      <tbody>
        <% orders.forEach(function (o) { %>
          <tr>
            <td><strong>#<%= o.orderNumber %></strong></td>
            <td><%= o.customerName %><br><small class="text-muted"><i class="bi bi-telephone"></i> <%= o.customerPhone %></small></td>
            <td><%= currency(o.total) %></td>
            <td><span class="badge bg-<%= statusBadge(o.status) %>"><%= statusLabel(o.status) %></span></td>
            <td><small class="text-muted"><%= o.deletedAt ? new Date(o.deletedAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—' %></small></td>
            <td>
              <form method="post" action="/admin/orders/deleted/<%= o._id %>/restore" class="d-inline js-confirm" data-confirm="Restore order #<%= o.orderNumber %> back to All Orders?">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (!orders.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No deleted orders.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
