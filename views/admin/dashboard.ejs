<%- include('partials/admin-header') %>

<div class="stat-cards">
  <div class="stat-card">
    <div class="stat-icon bg-primary"><i class="bi bi-cash-stack"></i></div>
    <div><span class="stat-value"><%= currency(totalSales) %></span><span class="stat-label">Total Sales</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-success"><i class="bi bi-bag-check"></i></div>
    <div><span class="stat-value"><%= totalOrders %></span><span class="stat-label">Total Orders</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-warning"><i class="bi bi-hourglass-split"></i></div>
    <div><span class="stat-value"><%= pendingOrders %></span><span class="stat-label">Pending Orders</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-info"><i class="bi bi-people"></i></div>
    <div><span class="stat-value"><%= totalCustomers %></span><span class="stat-label">Customers</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-secondary"><i class="bi bi-box-seam"></i></div>
    <div><span class="stat-value"><%= totalProducts %></span><span class="stat-label">Products</span></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-danger"><i class="bi bi-exclamation-triangle"></i></div>
    <div><span class="stat-value"><%= lowStock %></span><span class="stat-label">Low Stock</span></div>
  </div>
</div>

<div class="row g-4 mt-1">
  <div class="col-lg-8">
    <div class="admin-card">
      <h5>Sales Trend (Last 7 Days)</h5>
      <canvas id="salesChart" height="110"></canvas>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="admin-card">
      <h5>Quick Links</h5>
      <div class="d-grid gap-2">
        <a href="/admin/products/new" class="btn btn-brand"><i class="bi bi-plus-circle"></i> Add New Product</a>
        <a href="/admin/orders" class="btn btn-outline-secondary"><i class="bi bi-bag"></i> View Orders</a>
        <a href="/admin/reports" class="btn btn-outline-secondary"><i class="bi bi-graph-up"></i> Detailed Report</a>
      </div>
    </div>
  </div>
</div>

<div class="admin-card mt-4">
  <h5>Recent Orders</h5>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Order#</th><th>Customer</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% recentOrders.forEach(function (o) { %>
          <tr>
            <td>#<%= o.orderNumber %></td>
            <td><%= o.customerName %></td>
            <td><%= new Date(o.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
            <td><%= currency(o.total) %></td>
            <td><span class="badge bg-<%= o.paymentStatus === 'paid' ? 'success' : 'secondary' %>"><%= o.paymentStatus %></span></td>
            <td><span class="badge status-badge status-<%= o.status %>"><%= o.status %></span></td>
            <td><a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-primary">View</a></td>
          </tr>
        <% }); %>
        <% if (!recentOrders.length) { %><tr><td colspan="7" class="text-center text-muted">No orders yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
new Chart(document.getElementById('salesChart'), {
  type: 'line',
  data: {
    labels: <%- JSON.stringify(chartLabels) %>,
    datasets: [{
      label: 'Sales (<%= settings.currency_symbol %>)',
      data: <%- JSON.stringify(chartData) %>,
      borderColor: '#1e3a5f',
      backgroundColor: 'rgba(30,58,95,0.1)',
      tension: 0.35,
      fill: true,
      pointRadius: 4,
    }]
  },
  options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
});
</script>

<%- include('partials/admin-footer') %>
