<%- include('partials/admin-header') %>

<!-- ---------- Status tab pills ---------- -->
<div class="order-tabs mb-3">
  <a href="/admin/orders" class="order-tab <%= !status ? 'active' : '' %>">All Orders <span class="order-tab-count"><%= totalAll %></span></a>
  <% ORDER_STATUSES.forEach(function (s) { %>
    <a href="/admin/orders?status=<%= s.value %>" class="order-tab <%= status === s.value ? 'active' : '' %>"><%= s.label %> <span class="order-tab-count"><%= countMap[s.value] || 0 %></span></a>
  <% }); %>
</div>

<div class="admin-card mb-3">
  <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
    <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <input type="text" name="q" class="form-control" style="max-width:220px" placeholder="Order#, name or phone" value="<%= q %>">
    <select name="dateFilter" class="form-select" style="max-width:160px" onchange="this.form.submit()">
      <option value="">All Dates</option>
      <option value="today" <%= dateFilter === 'today' ? 'selected' : '' %>>Today</option>
      <option value="yesterday" <%= dateFilter === 'yesterday' ? 'selected' : '' %>>Yesterday</option>
      <option value="this_week" <%= dateFilter === 'this_week' ? 'selected' : '' %>>This Week</option>
      <option value="this_month" <%= dateFilter === 'this_month' ? 'selected' : '' %>>This Month</option>
    </select>
    <select name="employee" class="form-select" style="max-width:180px" onchange="this.form.submit()">
      <option value="">Assign Employee (all)</option>
      <% employees.forEach(function (e) { %>
        <option value="<%= e._id %>" <%= employee === String(e._id) ? 'selected' : '' %>><%= e.fullName || e.username %></option>
      <% }); %>
    </select>
    <select name="courier" class="form-select" style="max-width:160px" onchange="this.form.submit()">
      <option value="">Select Courier (all)</option>
      <% COURIERS.filter(function (c) { return c.value; }).forEach(function (c) { %>
        <option value="<%= c.value %>" <%= courier === c.value ? 'selected' : '' %>><%= c.label %></option>
      <% }); %>
    </select>
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
    <a href="/admin/orders" class="btn btn-outline-secondary" title="Reset filters"><i class="bi bi-arrow-clockwise"></i> Refresh</a>

    <div class="ms-auto d-flex gap-2">
      <button type="button" class="btn btn-outline-secondary" disabled title="Add a Pathao or Steadfast courier account first (Manage Delivery — coming soon) before syncing.">
        <i class="bi bi-truck"></i> Sync Courier
      </button>
      <a href="/admin/orders/manual" class="btn btn-brand"><i class="bi bi-plus-lg"></i> Manual Order</a>
    </div>
  </form>
</div>

<div class="admin-card">
  <form method="post" id="ordersForm">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
      <div class="form-check">
        <input type="checkbox" class="form-check-input js-select-all" id="selectAllOrders">
        <label class="form-check-label" for="selectAllOrders">Select All</label>
      </div>
      <select name="status" class="form-select" style="max-width:200px">
        <option value="">-- Change status to --</option>
        <% ORDER_STATUSES.forEach(function (s) { %>
          <option value="<%= s.value %>"><%= s.label %></option>
        <% }); %>
      </select>
      <button type="submit" formaction="/admin/orders/bulk-status" class="btn btn-outline-primary btn-sm">Save Status</button>
      <button type="submit" formaction="/admin/orders/bulk-delete" class="btn btn-outline-danger btn-sm js-confirm" data-confirm="Move the selected order(s) to Deleted Orders?">
        <i class="bi bi-trash"></i> Delete Selected
      </button>
    </div>

    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th></th>
            <th>Order ID</th>
            <th>Customer Info</th>
            <th>Products</th>
            <th>Amount</th>
            <th>Source</th>
            <th>Activities</th>
            <th>Status</th>
            <th>Courier</th>
            <th>Note</th>
            <th>Employee</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><input type="checkbox" class="form-check-input" name="ids" value="<%= o._id %>"></td>
              <td>
                <strong>#<%= o.orderNumber %></strong>
                <br><small class="text-muted"><%= new Date(o.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
              </td>
              <td>
                <%= o.customerName %>
                <br><small class="text-muted"><i class="bi bi-telephone"></i> <%= o.customerPhone %></small>
              </td>
              <td>
                <small><%= o.items.map(function (i) { return i.productName + ' x' + i.qty; }).join(', ') %></small>
              </td>
              <td><%= currency(o.total) %></td>
              <td><span class="badge bg-<%= o.source === 'manual' ? 'secondary' : 'light text-dark border' %>"><%= o.source === 'manual' ? 'Manual' : 'Website' %></span></td>
              <td>
                <% var lastActivity = o.activityLog && o.activityLog.length ? o.activityLog[o.activityLog.length - 1] : null; %>
                <% if (lastActivity) { %>
                  <small class="text-muted"><%= lastActivity.message %></small>
                <% } else { %>
                  <small class="text-muted">&mdash;</small>
                <% } %>
              </td>
              <td><span class="badge bg-<%= statusBadge(o.status) %>"><%= statusLabel(o.status) %></span></td>
              <td><%= o.courier ? COURIERS.find(function (c) { return c.value === o.courier; }).label : '—' %></td>
              <td><small class="text-muted"><%= o.adminNote ? (o.adminNote.length > 24 ? o.adminNote.slice(0, 24) + '…' : o.adminNote) : '—' %></small></td>
              <td><%= o.assignedEmployee ? (o.assignedEmployee.fullName || o.assignedEmployee.username) : '—' %></td>
              <td><a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-primary">Details</a></td>
            </tr>
          <% }); %>
          <% if (!orders.length) { %><tr><td colspan="12" class="text-center text-muted py-4">No orders found.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </form>
</div>

<%- include('partials/admin-footer') %>
