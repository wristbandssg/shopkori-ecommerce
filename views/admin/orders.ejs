<%- include('partials/admin-header') %>

<div class="admin-card">
  <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
    <form method="get" class="d-flex gap-2 flex-wrap">
      <input type="text" name="q" class="form-control" placeholder="অর্ডার#, নাম বা ফোন খুঁজুন" value="<%= q %>">
      <select name="status" class="form-select" onchange="this.form.submit()">
        <option value="">সকল স্ট্যাটাস</option>
        <% ['pending', 'processing', 'shipped', 'delivered', 'cancelled'].forEach(function (s) { %>
          <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
        <% }); %>
      </select>
      <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>অর্ডার#</th><th>কাস্টমার</th><th>ফোন</th><th>তারিখ</th><th>মোট</th><th>পেমেন্ট</th><th>স্ট্যাটাস</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(function (o) { %>
          <tr>
            <td>#<%= o.orderNumber %></td>
            <td><%= o.customerName %></td>
            <td><%= o.customerPhone %></td>
            <td><%= new Date(o.createdAt).toLocaleString('bn-BD', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
            <td><%= currency(o.total) %></td>
            <td>
              <span class="badge bg-<%= o.paymentStatus === 'paid' ? 'success' : 'secondary' %>"><%= o.paymentStatus %></span>
              <br><small class="text-muted"><%= o.paymentMethod.toUpperCase() %></small>
            </td>
            <td><span class="badge status-badge status-<%= o.status %>"><%= o.status %></span></td>
            <td><a href="/admin/orders/<%= o._id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td>
          </tr>
        <% }); %>
        <% if (!orders.length) { %><tr><td colspan="8" class="text-center text-muted">কোনো অর্ডার পাওয়া যায়নি।</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
