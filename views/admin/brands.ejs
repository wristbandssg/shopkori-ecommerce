<%- include('partials/admin-header') %>

<div class="admin-card mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-award-fill text-brand"></i> All Brands</h4>
    <a href="/admin/products/brands/new" class="btn btn-brand"><i class="bi bi-plus-circle"></i> New Brand</a>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Logo</th><th>Name</th><th>Slug</th><th>Order</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% brands.forEach(function (b) { %>
          <tr>
            <td><img src="<%= categoryImageUrl(b.image) %>" class="admin-thumb"></td>
            <td><%= b.name %></td>
            <td><code><%= b.slug %></code></td>
            <td><%= b.sortOrder %></td>
            <td><span class="badge bg-<%= b.status ? 'success' : 'secondary' %>"><%= b.status ? 'Active' : 'Hidden' %></span></td>
            <td class="text-nowrap">
              <a href="/admin/products/brands/<%= b._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <a href="/admin/products/brands/delete/<%= b._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this brand?" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }); %>
        <% if (!brands.length) { %><tr><td colspan="6" class="text-center text-muted">No brands yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
