<%- include('partials/admin-header') %>

<div class="admin-card">
  <h5>স্ট্যাটিক পেজ ম্যানেজমেন্ট</h5>
  <p class="text-muted" style="margin-top:-10px;">এখান থেকে "About Us", "FAQ", "How to order", "How to pay" এবং পলিসি পেজগুলোর লেখা এডিট করুন — সাইটে সাথে সাথে বদলে যাবে।</p>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>পেজ</th><th>শিরোনাম</th><th>একশন</th></tr></thead>
      <tbody>
        <% pages.forEach(function (p) { %>
          <tr>
            <td><code><%= p.key %></code></td>
            <td><%= p.title %></td>
            <td>
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPage<%= p.key %>"><i class="bi bi-pencil"></i> এডিট</button>
            </td>
          </tr>

          <div class="modal fade" id="editPage<%= p.key %>" tabindex="-1">
            <div class="modal-dialog modal-lg">
              <div class="modal-content">
                <form method="post" action="/admin/pages/<%= p.key %>">
                  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                  <div class="modal-header">
                    <h5 class="modal-title"><%= p.title %> এডিট করুন</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">শিরোনাম</label>
                      <input type="text" name="title" class="form-control" value="<%= p.title %>" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">বিস্তারিত লেখা</label>
                      <textarea name="body" class="form-control" rows="8"><%= p.body %></textarea>
                    </div>
                  </div>
                  <div class="modal-footer"><button type="submit" class="btn btn-brand">সংরক্ষণ করুন</button></div>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
