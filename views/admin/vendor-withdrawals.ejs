<%- include('partials/admin-header') %>
<%
  const wStatusBadge = { pending: ['secondary', 'Pending'], approved: ['success', 'Approved'], rejected: ['danger', 'Rejected'] };
%>

<div class="admin-card mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-cash-coin text-brand"></i> Vendor Withdrawal Requests</h4>
    <a href="/admin/vendors" class="btn btn-outline-secondary">All Vendors</a>
  </div>
  <div class="d-flex gap-2 mt-3">
    <a href="/admin/vendors/withdrawals" class="btn btn-sm btn-outline-secondary <%= !filterStatus ? 'active' : '' %>">All</a>
    <a href="/admin/vendors/withdrawals?status=pending" class="btn btn-sm btn-outline-secondary <%= filterStatus === 'pending' ? 'active' : '' %>">Pending</a>
    <a href="/admin/vendors/withdrawals?status=approved" class="btn btn-sm btn-outline-secondary <%= filterStatus === 'approved' ? 'active' : '' %>">Approved</a>
    <a href="/admin/vendors/withdrawals?status=rejected" class="btn btn-sm btn-outline-secondary <%= filterStatus === 'rejected' ? 'active' : '' %>">Rejected</a>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Date</th><th>Vendor</th><th>Amount</th><th>Method</th><th>Details</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% withdrawals.forEach(function (w) { %>
          <tr>
            <td><%= new Date(w.createdAt).toLocaleDateString('en-GB') %></td>
            <td><%= w.vendor ? w.vendor.storeName : '—' %></td>
            <td><%= currency(w.amount) %></td>
            <td><%= w.method %></td>
            <td><small class="text-muted"><%= w.methodDetails %><% if (w.note) { %> — <%= w.note %><% } %></small></td>
            <td><span class="badge bg-<%= wStatusBadge[w.status][0] %>"><%= wStatusBadge[w.status][1] %></span></td>
            <td class="text-nowrap">
              <% if (w.status === 'pending') { %>
                <form method="post" action="/admin/vendors/withdrawals/<%= w._id %>/approve" class="d-inline js-confirm" data-confirm="Approve this withdrawal and debit the vendor's wallet?">
                  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2"></i></button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectWd<%= w._id %>"><i class="bi bi-x"></i></button>
                <div class="modal fade" id="rejectWd<%= w._id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <form method="post" action="/admin/vendors/withdrawals/<%= w._id %>/reject">
                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                        <div class="modal-header"><h5 class="modal-title">Reject Withdrawal</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                        <div class="modal-body">
                          <label class="form-label">Reason</label>
                          <textarea name="reason" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer"><button type="submit" class="btn btn-danger">Reject</button></div>
                      </form>
                    </div>
                  </div>
                </div>
              <% } else { %>
                <span class="text-muted small">—</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (!withdrawals.length) { %><tr><td colspan="7" class="text-center text-muted">No withdrawal requests.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
