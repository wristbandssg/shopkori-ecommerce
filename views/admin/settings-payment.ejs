<%- include('partials/admin-header') %>

<nav class="small mb-3">
  <a href="/admin" class="text-decoration-none">Home</a>
  <span class="text-muted mx-1">&gt;</span>
  <a href="/admin/settings" class="text-decoration-none">Settings</a>
  <span class="text-muted mx-1">&gt;</span>
  <span class="text-muted">Payment Settings</span>
</nav>

<div class="row g-3" id="paymentGrid">
  <% PAYMENT_CARDS.forEach(function (key) { %>
    <% var m = PAYMENT_CARD_META[key]; %>
    <% var on = payment[key] && payment[key].status; %>
    <div class="col-md-4 payment-grid-item" data-name="<%= m.title.toLowerCase() %>">
      <a href="/admin/settings/payment/<%= m.path %>" class="text-decoration-none">
        <div class="admin-card d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center rounded-circle text-white" style="width:44px;height:44px;background:<%= m.color %>;font-size:1.1rem;flex-shrink:0;">
              <i class="bi <%= m.icon %>"></i>
            </div>
            <div>
              <div class="fw-semibold text-dark"><%= m.title %></div>
              <span class="small text-primary">Manage <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
          <span class="badge bg-<%= on ? 'success' : 'secondary' %>"><%= on ? 'Active' : 'Inactive' %></span>
        </div>
      </a>
    </div>
  <% }); %>
</div>

<%- include('partials/admin-footer') %>
