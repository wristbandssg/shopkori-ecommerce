<%- include('partials/admin-header') %>

<div class="admin-card mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-globe2 text-brand"></i> Short Landing</h4>
    <a href="/admin/landing-page/short/new" class="btn btn-brand"><i class="bi bi-plus-circle"></i> Add Landing Page</a>
  </div>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>#</th><th>Image</th><th>Title</th><th>Slug</th><th>Action</th></tr></thead>
      <tbody>
        <% shortLandingPages.forEach(function (p, i) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><img src="<%= landingImageUrl(p.image) %>" class="admin-thumb"></td>
            <td>
              <%= p.title %>
              <span class="badge bg-<%= p.status ? 'success' : 'secondary' %> ms-1"><%= p.status ? 'Active' : 'Hidden' %></span>
            </td>
            <td><code><%= p.slug %></code></td>
            <td class="text-nowrap">
              <a href="/admin/landing-page/short/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <a href="/admin/landing-page/short/delete/<%= p._id %>?csrf=<%= csrfToken %>" class="btn btn-sm btn-outline-danger js-confirm" data-confirm="Delete this landing page?" title="Delete"><i class="bi bi-trash"></i></a>
            </td>
          </tr>
        <% }); %>
        <% if (!shortLandingPages.length) { %><tr><td colspan="5" class="text-center text-muted">No short landing pages yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
