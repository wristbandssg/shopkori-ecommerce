<%- include('partials/header') %>
<div class="container py-5">
  <h2 class="section-heading mb-4">ব্লগ</h2>

  <% if (!posts.length) { %>
    <div class="static-page mx-auto text-center">
      <i class="bi bi-journal-richtext" style="font-size: 48px; color: var(--brand-gold);"></i>
      <p class="text-muted mt-3">খুব শীঘ্রই আমরা গিফট আইডিয়া, অফার ও টিপস নিয়ে ব্লগ পোস্ট প্রকাশ করবো। আপডেট পেতে চোখ রাখুন!</p>
      <a href="/" class="btn btn-add-cart px-4 py-2 d-inline-block mt-2" style="width:auto;">হোমপেজে ফিরে যান</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% posts.forEach(function (post) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <a href="/blog/<%= post.slug %>" class="text-decoration-none">
            <div class="product-card h-100">
              <div class="product-card-img">
                <img src="<%= post.coverImage ? productImageUrl(post.coverImage) : '/images/product-placeholder.svg' %>" alt="<%= post.title %>">
              </div>
              <div class="product-card-body">
                <small class="text-muted"><%= post.createdAt.toLocaleDateString('bn-BD') %></small>
                <div class="product-title"><%= post.title %></div>
                <% if (post.excerpt) { %>
                  <p class="text-muted mb-0" style="font-size:13px;"><%= post.excerpt %></p>
                <% } %>
              </div>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
