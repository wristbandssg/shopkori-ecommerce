<%- include('partials/header') %>

<div class="container py-5">
  <div class="order-success-box text-center">
    <i class="bi bi-check-circle-fill display-1 text-success"></i>
    <h2 class="mt-3">ধন্যবাদ, <%= order.customerName %>!</h2>
    <p class="lead">আপনার অর্ডারটি সফলভাবে সম্পন্ন হয়েছে।</p>
    <p>অর্ডার নম্বর: <strong>#<%= order.orderNumber %></strong></p>
  </div>

  <div class="row justify-content-center mt-4">
    <div class="col-lg-7">
      <div class="checkout-box">
        <h5>অর্ডার বিবরণ</h5>
        <ul class="checkout-item-list">
          <% order.items.forEach(function (item) { %>
            <li>
              <img src="<%= productImageUrl(item.productImage) %>" alt="">
              <div class="flex-grow-1">
                <div><%= item.productName %></div>
                <small class="text-muted">Qty: <%= item.qty %></small>
              </div>
              <div><%= currency(item.lineTotal) %></div>
            </li>
          <% }); %>
        </ul>
        <hr>
        <div class="d-flex justify-content-between"><span>সাবটোটাল</span><span><%= currency(order.subtotal) %></span></div>
        <div class="d-flex justify-content-between"><span>ডেলিভারি চার্জ</span><span><%= currency(order.shippingFee) %></span></div>
        <div class="d-flex justify-content-between fw-bold fs-5"><span>মোট</span><span><%= currency(order.total) %></span></div>
        <hr>
        <p class="mb-1"><strong>পেমেন্ট মেথড:</strong> <%= order.paymentMethod.toUpperCase() %></p>
        <p class="mb-1"><strong>পেমেন্ট স্ট্যাটাস:</strong> <span class="badge bg-<%= order.paymentStatus === 'paid' ? 'success' : 'warning' %>"><%= order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1) %></span></p>
        <p class="mb-0"><strong>ডেলিভারি ঠিকানা:</strong> <%= order.shippingAddress %>, <%= order.shippingCity %></p>
      </div>
      <div class="text-center mt-4">
        <a href="/" class="btn btn-primary">শপিং চালিয়ে যান</a>
        <a href="/track-order?order=<%= order.orderNumber %>" class="btn btn-outline-secondary">অর্ডার ট্র্যাক করুন</a>
      </div>
    </div>
  </div>

  <% if (upsellProducts && upsellProducts.length) { %>
    <div class="row justify-content-center mt-5">
      <div class="col-lg-10">
        <div class="section-heading">
          <h2>আপনার জন্য বিশেষ অফার</h2>
          <% if (offerText) { %><p class="text-muted mb-0"><%= offerText %></p><% } %>
        </div>
        <div class="product-grid">
          <% upsellProducts.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
