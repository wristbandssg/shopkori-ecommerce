<%- include('partials/header') %>

<!-- Hero banner -->
<section class="hero">
  <div class="container">
    <div class="hero-slide">
      <div class="hero-text">
        <span class="hero-badge">সেম ডে ডেলিভারি</span>
        <h1>গিফট, গ্রোসারি &amp; প্রয়োজনীয় সবকিছু<br>এক ঠিকানায়</h1>
        <p>ঢাকা শহরে সেম ডে ডেলিভারি, সারা বাংলাদেশে ২৪-৪৮ ঘন্টায় হোম ডেলিভারি।</p>
        <a href="/category/birthday-gifts" class="btn btn-hero">এখনই কিনুন <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- Category strip -->
<section class="section">
  <div class="container">
    <div class="section-banner">আপনার পছন্দের ক্যাটাগরি</div>
    <div class="category-grid">
      <% categories.forEach(function (cat) { %>
        <a href="/category/<%= cat.slug %>" class="category-tile">
          <div class="category-tile-img">
            <img src="<%= categoryImageUrl(cat.image) %>" alt="<%= cat.name %>" onerror="this.src='/images/category-placeholder.svg'">
          </div>
          <span><%= cat.name %></span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%
  // Admin > Offer Setting drives these 3 sections: Flash Sale/Popular
  // Products select which products get isFlashSale/isFeatured (see
  // routes/admin.js), and each card's "Show/Hide" toggle (`enabled`) can
  // hide the whole section even if products are flagged. Latest Products'
  // toggle gates New Arrivals, which has no separate product list of its
  // own (it's just "most recently added").
  const fsCard = offerSettings.flashSale;
  const fsEndsAt = fsCard.timerEnabled && fsCard.endsAt ? new Date(fsCard.endsAt) : null;
  const fsCountdownLive = fsEndsAt && fsEndsAt.getTime() > Date.now();
%>
<% if (fsCard.enabled && flashSale.length) { %>
<!-- Flash sale -->
<section class="section flash-sale-section">
  <div class="container">
    <div class="section-heading">
      <h2><i class="bi bi-lightning-charge-fill text-warning"></i> ফ্ল্যাশ সেল</h2>
      <% if (fsCountdownLive) { %>
        <span class="countdown-badge" id="flashSaleCountdown" data-ends-at="<%= fsEndsAt.toISOString() %>"
          style="color:<%= fsCard.textColor %>;border-color:<%= fsCard.borderColor %>;background:<%= fsCard.backgroundColor %>;">--:--:--</span>
      <% } else { %>
        <span class="countdown-badge">সীমিত সময়ের অফার!</span>
      <% } %>
    </div>
    <div class="product-grid">
      <% flashSale.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
    </div>
  </div>
</section>
<% if (fsCountdownLive) { %>
<script>
(function () {
  var el = document.getElementById('flashSaleCountdown');
  if (!el) return;
  var endsAt = new Date(el.getAttribute('data-ends-at')).getTime();
  function tick() {
    var diff = endsAt - Date.now();
    if (diff <= 0) { el.textContent = 'অফার শেষ'; return; }
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    el.textContent = d + 'দিন ' + h + ':' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    setTimeout(tick, 1000);
  }
  tick();
})();
</script>
<% } %>
<% } %>

<% if (offerSettings.popular.enabled) { %>
<!-- Featured products -->
<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>জনপ্রিয় প্রোডাক্ট</h2>
    </div>
    <div class="product-grid">
      <% featured.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (offerSettings.latest.enabled) { %>
<!-- New arrivals -->
<section class="section bg-light-section">
  <div class="container">
    <div class="section-heading">
      <h2>নতুন সংযোজন</h2>
    </div>
    <div class="product-grid">
      <% newArrivals.forEach(function (p) { %><%- include('partials/product-card', { p }) %><% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Trust badges -->
<section class="section">
  <div class="container">
    <div class="trust-row">
      <div class="trust-item"><i class="bi bi-truck"></i><div><strong>সেম ডে ডেলিভারি</strong><span>ঢাকার মধ্যে</span></div></div>
      <div class="trust-item"><i class="bi bi-shield-check"></i><div><strong>নিরাপদ পেমেন্ট</strong><span>COD, bKash, কার্ড</span></div></div>
      <div class="trust-item"><i class="bi bi-arrow-repeat"></i><div><strong>ইজি রিটার্ন</strong><span>৭ দিনের মধ্যে</span></div></div>
      <div class="trust-item"><i class="bi bi-headset"></i><div><strong>২৪/৭ সাপোর্ট</strong><span>সব সময় পাশে আছি</span></div></div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
