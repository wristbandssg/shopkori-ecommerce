# Copy this file to .env and fill in your real values.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/shopkori
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopkori?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopkori

# Session secret - change this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-secret

# Port the app listens on (most cloud hosts set this automatically via process.env.PORT)
PORT=3000

# bKash (manual "Send Money" flow)
BKASH_NUMBER=01700-000000
BKASH_TYPE=Send Money

# SSLCommerz (card / mobile banking gateway) - https://developer.sslcommerz.com/
SSLCZ_STORE_ID=testbox
SSLCZ_STORE_PASSWORD=qwerty
SSLCZ_SANDBOX=true

# Default admin login created by "npm run seed"
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@shopkori.test
